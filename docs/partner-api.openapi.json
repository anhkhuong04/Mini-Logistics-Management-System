{
  "openapi": "3.1.1",
  "info": {
    "title": "MiniLogistics Partner API",
    "description": "Shop-scoped quote, shipment creation, tracking and cancellation API.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/partner/shipping/quote": {
      "post": {
        "tags": [
          "Partner API"
        ],
        "summary": "Calculate a shipping quote",
        "description": "Requires Quote scope. Default quota: 60 requests/minute/API client; retry HTTP 429 using Retry-After.",
        "operationId": "PartnerQuote",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/PartnerQuoteRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerShippingQuoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerApiKey": [ ]
          }
        ]
      }
    },
    "/api/v1/partner/shipments": {
      "post": {
        "tags": [
          "Partner API"
        ],
        "summary": "Create a shipment with an idempotency key",
        "description": "Requires CreateShipment scope and Idempotency-Key. Default quota: 30 requests/minute/API client. A Redis rate-store outage fails closed with HTTP 503 in production.",
        "operationId": "PartnerCreateShipment",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Unique key for safely replaying a create request.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/PartnerCreateShipmentRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerShipmentResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerShipmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerApiKey": [ ]
          }
        ]
      }
    },
    "/api/v1/partner/shipments/{trackingCode}": {
      "get": {
        "tags": [
          "Partner API"
        ],
        "summary": "Track any shipment owned by the API client's shop",
        "description": "Requires TrackShipment scope. Reads any shipment in the authenticated shop; externalOrderId is null unless owned by this API client. Default quota: 120 requests/minute/API client.",
        "operationId": "PartnerTrackShipment",
        "parameters": [
          {
            "name": "trackingCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerShipmentTrackingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerApiKey": [ ]
          }
        ]
      }
    },
    "/api/v1/partner/shipments/{trackingCode}/cancel": {
      "post": {
        "tags": [
          "Partner API"
        ],
        "summary": "Cancel a shipment created by the same API client",
        "description": "Requires CancelShipment scope and same-client shipment ownership. Default quota: 30 requests/minute/API client. A Redis rate-store outage fails closed with HTTP 503 in production.",
        "operationId": "PartnerCancelShipment",
        "parameters": [
          {
            "name": "trackingCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/PartnerCancelShipmentRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerShipmentTrackingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerApiKey": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CodStatus": {
        "enum": [
          "NotRequired",
          "PendingCollection",
          "Collected",
          "Settled"
        ],
        "description": "Defines the supported Cod Status values in the domain model."
      },
      "PartnerAddressRequest": {
        "required": [
          "street",
          "ward",
          "province",
          "country"
        ],
        "type": "object",
        "properties": {
          "street": {
            "type": [
              "null",
              "string"
            ]
          },
          "ward": {
            "type": [
              "null",
              "string"
            ]
          },
          "province": {
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PartnerApiError": {
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "PartnerApiErrorResponse": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/PartnerApiError"
          }
        }
      },
      "PartnerCancelShipmentRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PartnerCreateShipmentRequest": {
        "required": [
          "externalOrderId",
          "sender",
          "receiver",
          "pickupAddress",
          "deliveryAddress",
          "parcel",
          "goodsValueAmount",
          "codAmount",
          "currency",
          "note"
        ],
        "type": "object",
        "properties": {
          "externalOrderId": {
            "type": [
              "null",
              "string"
            ]
          },
          "sender": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PartnerPartyRequest"
              }
            ]
          },
          "receiver": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PartnerPartyRequest"
              }
            ]
          },
          "pickupAddress": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PartnerAddressRequest"
              }
            ]
          },
          "deliveryAddress": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PartnerAddressRequest"
              }
            ]
          },
          "parcel": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PartnerParcelRequest"
              }
            ]
          },
          "goodsValueAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "codAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": [
              "null",
              "string"
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PartnerParcelRequest": {
        "required": [
          "weightKg",
          "lengthCm",
          "widthCm",
          "heightCm"
        ],
        "type": "object",
        "properties": {
          "weightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "lengthCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "widthCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "heightCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "PartnerPartyRequest": {
        "required": [
          "name",
          "phone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PartnerQuoteRequest": {
        "required": [
          "externalOrderId",
          "pickupAddress",
          "deliveryAddress",
          "parcel",
          "goodsValueAmount",
          "codAmount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "externalOrderId": {
            "type": [
              "null",
              "string"
            ]
          },
          "pickupAddress": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PartnerAddressRequest"
              }
            ]
          },
          "deliveryAddress": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PartnerAddressRequest"
              }
            ]
          },
          "parcel": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PartnerParcelRequest"
              }
            ]
          },
          "goodsValueAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "codAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PartnerShipmentResponse": {
        "required": [
          "shipmentId",
          "externalOrderId",
          "trackingCode",
          "status",
          "routeType",
          "shippingFeeAmount",
          "currency",
          "createdAtUtc"
        ],
        "type": "object",
        "properties": {
          "shipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "externalOrderId": {
            "type": "string"
          },
          "trackingCode": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "routeType": {
            "$ref": "#/components/schemas/RouteType"
          },
          "shippingFeeAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PartnerShipmentTimelineItem": {
        "required": [
          "status",
          "messageCode",
          "message",
          "locale",
          "changedAtUtc"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "messageCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "changedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PartnerShipmentTrackingResponse": {
        "required": [
          "trackingCode",
          "externalOrderId",
          "status",
          "codStatus",
          "shippingFeeAmount",
          "currency",
          "timeline"
        ],
        "type": "object",
        "properties": {
          "trackingCode": {
            "type": "string"
          },
          "externalOrderId": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "codStatus": {
            "$ref": "#/components/schemas/CodStatus"
          },
          "shippingFeeAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartnerShipmentTimelineItem"
            }
          }
        }
      },
      "PartnerShippingQuoteResponse": {
        "required": [
          "routeType",
          "actualWeightKg",
          "volumetricWeightKg",
          "chargeableWeightKg",
          "baseFeeAmount",
          "extraWeightFeeAmount",
          "insuranceFeeAmount",
          "returnFeeAmount",
          "totalFeeAmount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "routeType": {
            "$ref": "#/components/schemas/RouteType"
          },
          "actualWeightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "volumetricWeightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "chargeableWeightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "baseFeeAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "extraWeightFeeAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "insuranceFeeAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "returnFeeAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "totalFeeAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "RouteType": {
        "enum": [
          "IntraProvince",
          "IntraRegion",
          "InterRegion"
        ],
        "description": "Defines the supported Route Type values in the domain model."
      },
      "ShipmentStatus": {
        "enum": [
          "Draft",
          "PendingPickup",
          "Assigned",
          "PickingUp",
          "PickedUp",
          "InTransit",
          "Delivering",
          "Delivered",
          "DeliveryFailed",
          "Returned",
          "Cancelled"
        ],
        "description": "Defines the supported Shipment Status values in the domain model."
      }
    },
    "securitySchemes": {
      "BearerApiKey": {
        "type": "http",
        "description": "Use the environment-specific ml_test_ or ml_live_ API key.",
        "scheme": "bearer",
        "bearerFormat": "MiniLogistics API key"
      }
    }
  },
  "tags": [
    {
      "name": "Partner API"
    }
  ]
}