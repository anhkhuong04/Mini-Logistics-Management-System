  "components": {
    "schemas": {
      "BrowserApiProblem": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "errors": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "BrowserCsrfResponse": {
        "required": [
          "requestToken"
        ],
        "type": "object",
        "properties": {
          "requestToken": {
            "type": "string"
          }
        }
      },
      "BrowserLoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "rememberMe": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "BrowserProvinceData": {
        "required": [
          "provinces",
          "serverTimeZoneId"
        ],
        "type": "object",
        "properties": {
          "provinces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProvinceOption"
            }
          },
          "serverTimeZoneId": {
            "type": "string"
          }
        }
      },
      "BrowserSession": {
        "required": [
          "userId",
          "displayName",
          "roles",
          "operationPermissions",
          "locale",
          "serverTimeZoneId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operationPermissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locale": {
            "type": "string"
          },
          "serverTimeZoneId": {
            "type": "string"
          }
        }
      },
      "BrowserShopContext": {
        "required": [
          "selectedShopId",
          "shops"
        ],
        "type": "object",
        "properties": {
          "selectedShopId": {
            "type": "string",
            "format": "uuid"
          },
          "shops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BrowserShopContextItem"
            }
          }
        }
      },
      "BrowserShopContextItem": {
        "required": [
          "shopId",
          "name",
          "phoneNumber",
          "addressLine",
          "ward",
          "province",
          "country",
          "isActive",
          "isOwner",
          "staffRole",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "shopId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "addressLine": {
            "type": "string"
          },
          "ward": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "isOwner": {
            "type": "boolean"
          },
          "staffRole": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ShopStaffRole"
              }
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProvinceOption": {
        "required": [
          "name",
          "wards"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "wards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WardOption"
            }
          }
        }
      },
      "RegisterShopCommand": {
        "required": [
          "fullName",
          "email",
          "password",
          "shopName",
          "phoneNumber",
          "addressLine",
          "ward",
          "province"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "shopName": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "addressLine": {
            "type": "string"
          },
          "ward": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "default": "Vietnam"
          }
        }
      },
      "ShopStaffRole": {
        "enum": [
