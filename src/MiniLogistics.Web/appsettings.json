{
  "PublicBaseUrl": "https://localhost:7195",
  "ConfigurationCache": {
    "KeyPrefix": "mini-logistics:development:configuration",
    "ConsistencyWindowSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PartnerApi": {
    "Environment": "Sandbox",
    "WebhookSecurity": {
      "AllowedPorts": [ 443 ],
      "ConnectTimeoutSeconds": 5,
      "RequestTimeoutSeconds": 10,
      "MaxResponseBodyBytes": 2048,
      "MaxResponseHeadersKilobytes": 16,
      "MaxConnectionsPerServer": 8
    },
    "RateLimiting": {
      "Mode": "Memory",
      "StoreTimeoutMilliseconds": 500,
      "StoreFailureThreshold": 3,
      "CircuitBreakSeconds": 10,
      "KeyPrefix": "mini-logistics",
      "QuoteLimitPerMinute": 60,
      "CreateShipmentLimitPerMinute": 30,
      "TrackingLimitPerMinute": 120,
      "CancelShipmentLimitPerMinute": 30
    },
    "Retention": {
      "Enabled": false,
      "RunOnStartup": false,
      "IntervalHours": 6,
      "SucceededQueueRetentionDays": 30,
      "RequestAuditRetentionDays": 180,
      "CredentialAuditRetentionDays": 365,
      "BatchSize": 1000
    }
  },
  "Cors": {
    "PartnerApi": {
      "AllowedOrigins": []
    }
  },
  "TrustedProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "ForwardedForHeaderName": "X-Forwarded-For",
    "ForwardedProtoHeaderName": "X-Forwarded-Proto"
  },
  "DataProtection": {
    "ApplicationName": "MiniLogistics",
    "KeysPath": "",
    "CertificatePath": "",
    "CertificatePassword": "",
    "KeyLifetimeDays": 90
  },
  "PublicTracking": {
    "RateLimiting": {
      "LimitPerMinute": 20
    }
  },
  "ShopUi": {
    "RateLimiting": {
      "CreateShipmentLimitPerMinute": 30,
      "ImportPreviewLimitPerMinute": 10,
      "ImportConfirmLimitPerMinute": 5,
      "ExportShipmentsLimitPerMinute": 10,
      "ExportCodReportLimitPerMinute": 10,
      "GenerateLabelLimitPerMinute": 30
    }
  },
  "Seeding": {
    "Enabled": false,
    "DemoPartnerApiKey": "",
    "DemoAdminPassword": "",
    "DemoShopPassword": "",
    "DemoShipperPassword": "",
    "DemoOperatorPassword": ""
  },
  "AllowedHosts": "*"
}
