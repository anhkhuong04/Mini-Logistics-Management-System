@page "/login"
@layout MiniLogistics.Web.Components.Layout.LandingLayout
@attribute [AllowAnonymous]

<PageTitle>Đăng nhập - LAK Logistics</PageTitle>

<main class="auth-page login-page">
    <section class="auth-shell" aria-label="Đăng nhập LAK Logistics">
        <a class="auth-brand" href="/" aria-label="LAK Logistics">
            <img src="/images/landing/lak-logo.svg" alt="LAK Logistics" />
        </a>

        <div class="auth-card">
            <div class="auth-card-head">
                <h1>Đăng nhập</h1>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="auth-error" role="alert">@UiDisplay.ToErrorMessage(Error)</div>
            }

            <form method="post" action="/auth/login" class="auth-form">
                <AntiforgeryToken />

                <label class="form-field" for="email">
                    <span>Email hoặc số điện thoại</span>
                    <input id="email" class="form-input" name="Email" type="text" autocomplete="username" required maxlength="100"/>
                </label>

                <label class="form-field" for="password">
                    <span>Mật khẩu</span>
                    <input id="password" class="form-input" name="Password" type="password" autocomplete="current-password" required maxlength="100" />
                </label>

                <button type="submit" class="auth-primary">Đăng nhập</button>
            </form>

            <p class="auth-switch">Chưa có tài khoản? <a href="/register-shop">Đăng ký shop</a></p>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
