@page "/tracking"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Http
@using MiniLogistics.Application.Shipments.GetPublicTracking
@using MiniLogistics.Domain.Shipments
@inject IGetPublicTrackingService GetPublicTrackingService
@inject IPublicTrackingRateLimiter TrackingRateLimiter
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Tracking_PageTitle"]</PageTitle>

<div class="tracking-page">
    <header class="tracking-hero">
        <div>
            <p class="tracking-eyebrow">@L["Tracking_Eyebrow"]</p>
            <h1>@L["Tracking_Title"]</h1>
            <p>@L["Tracking_Description"]</p>
        </div>
    </header>

    <section class="tracking-search-zone" aria-labelledby="tracking-search-title">
        <div class="section-heading">
            <span class="section-icon"><AppIcon Name="search" Size="21" /></span>
            <div>
                <h2 id="tracking-search-title">@L["Tracking_SearchTitle"]</h2>
                <p>@L["Tracking_SearchDescription"]</p>
            </div>
        </div>

        <EditForm Model="Form" OnValidSubmit="HandleSearchAsync" class="tracking-form">
            <DataAnnotationsValidator />

            <div class="search-input-group">
                <InputText id="tracking-code" class="tracking-input" placeholder="@L["Tracking_Placeholder"]" autocomplete="off" @bind-Value="Form.TrackingCode" />
                <button class="ui-button ui-button--primary search-button" type="submit" disabled="@IsSearching">
                    <AppIcon Name="search" Size="18" />
                    <span>@(IsSearching ? L["Tracking_Searching"] : L["Tracking_Search"])</span>
                </button>
            </div>
            <ValidationMessage For="() => Form.TrackingCode" />
            <p class="search-hint">@L["Tracking_Hint"]</p>
        </EditForm>
    </section>

    <section class="tracking-result-zone" aria-labelledby="tracking-result-title" aria-live="polite">
        <div class="result-zone-heading">
            <div>
                <p class="tracking-eyebrow">@L["Tracking_ResultEyebrow"]</p>
                <h2 id="tracking-result-title">@L["Tracking_ResultTitle"]</h2>
            </div>
            @if (TrackingResult is not null)
            {
                <span class="status-pill @GetStatusClass(TrackingResult.CurrentStatus)">@FormatStatus(TrackingResult.CurrentStatus)</span>
            }
        </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="empty-result">
                    <span class="result-icon danger"><AppIcon Name="alert" Size="26" /></span>
                    <strong>@L["Tracking_NotFound"]</strong>
                    <p>@ErrorMessage</p>
                </div>
            }
            else if (TrackingResult is null)
            {
                <div class="empty-result">
                    <span class="result-icon"><AppIcon Name="package" Size="26" /></span>
                    <strong>@L["Tracking_EmptyTitle"]</strong>
                    <p>@L["Tracking_EmptyDescription"]</p>
                </div>
            }
            else
            {
                <div class="tracking-summary mockup-layout">
                    <div class="tracking-header">
                        <div class="col-left">
                            <span class="label-text">@L["Tracking_Code"]</span>
                            <div class="status-indicator">
                                <span class="status-dot @GetStatusClass(TrackingResult.CurrentStatus)">●</span>
                                <strong>@FormatStatus(TrackingResult.CurrentStatus).ToUpper()</strong>
                            </div>
                        </div>
                        <div class="col-right text-end">
                            <span class="tracking-code-text">#@TrackingResult.TrackingCode</span>
                            <span class="expected-date">@L["Tracking_Estimated", TrackingResult.CreatedAtUtc.AddDays(2).ToString("d")].Value</span>
                        </div>
                    </div>

                    <div class="location-grid">
                        <div class="col-left">
                            <strong>@TrackingResult.PickupProvince</strong>
                            <span class="date-text">@TrackingResult.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="col-right text-end">
                            <strong>@TrackingResult.DeliveryProvince</strong>
                            <span class="date-text">@L["Tracking_EstimatedShort", TrackingResult.CreatedAtUtc.AddDays(2).ToString("d")].Value</span>
                        </div>
                    </div>
                </div>

                <div class="horizontal-progress-bar">
                    @{
                        var step = GetProgressStep(TrackingResult.CurrentStatus);
                    }
                    <div class="progress-track">
                        <div class="progress-node @(step >= 1 ? "active" : "")">
                            <span class="node-dot"></span>
                            <span class="node-label">@L["Tracking_PickedUp"]</span>
                        </div>
                        <div class="progress-line @(step >= 2 ? "active" : "")"></div>
                        <div class="progress-node @(step >= 2 ? "active" : "")">
                            <span class="node-dot"></span>
                            <span class="node-label">@L["Tracking_Sorting"]</span>
                        </div>
                        <div class="progress-line @(step >= 3 ? "active" : "")"></div>
                        <div class="progress-node @(step >= 3 ? "active" : "")">
                            <span class="node-dot"></span>
                            <span class="node-label">@L["Tracking_InTransit"]</span>
                        </div>
                        <div class="progress-line @(step >= 4 ? "active" : "")"></div>
                        <div class="progress-node @(step >= 4 ? "active" : "")">
                            <span class="node-dot"></span>
                            <span class="node-label">@L["Tracking_Delivery"]</span>
                        </div>
                    </div>
                </div>

                <dl class="summary-grid detail-grid">
                    <div>
                        <dt>@L["Tracking_SenderPhone"]</dt>
                        <dd>@DisplayOrHidden(TrackingResult.SenderPhone)</dd>
                    </div>
                    <div>
                        <dt>@L["Tracking_ReceiverPhone"]</dt>
                        <dd>@DisplayOrHidden(TrackingResult.ReceiverPhone)</dd>
                    </div>
                    <div>
                        <dt>@L["Tracking_PickupAddress"]</dt>
                        <dd>@DisplayOrHidden(TrackingResult.PickupAddress?.FullAddress)</dd>
                    </div>
                    <div>
                        <dt>@L["Tracking_DeliveryAddress"]</dt>
                        <dd>@DisplayOrHidden(TrackingResult.DeliveryAddress?.FullAddress)</dd>
                    </div>
                </dl>

                <h2 class="timeline-title">@L["Tracking_Journey"]</h2>
                <ol class="timeline mockup-timeline">
                    @foreach (var item in TrackingResult.Timeline.OrderByDescending(x => x.ChangedAtUtc))
                    {
                        <li>
                            <span class="timeline-dot"></span>
                            <div>
                                <strong>@FormatStatus(item.Status)</strong>
                                <p>@GetTimelineMessage(item)</p>
                                <time>@FormatDate(item.ChangedAtUtc)</time>
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>
</div>

@code {
    private TrackingFormModel Form { get; set; } = new();

    private bool IsSearching { get; set; }

    private string? LoadedQueryCode { get; set; }

    private string? ErrorMessage { get; set; }

    private PublicTrackingResponse? TrackingResult { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? QueryTrackingCode { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var normalizedCode = QueryTrackingCode?.Trim();
        if (string.IsNullOrWhiteSpace(normalizedCode)
            || string.Equals(LoadedQueryCode, normalizedCode, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        LoadedQueryCode = normalizedCode;
        Form.TrackingCode = normalizedCode;

        IsSearching = true;
        try
        {
            await SearchAsync(normalizedCode);
        }
        finally
        {
            IsSearching = false;
        }
    }

    private async Task HandleSearchAsync()
    {
        IsSearching = true;
        try
        {
            await SearchAsync(Form.TrackingCode);
        }
        finally
        {
            IsSearching = false;
        }
    }

    private async Task SearchAsync(string trackingCode)
    {
        var normalizedCode = trackingCode.Trim();
        ErrorMessage = null;
        TrackingResult = null;

        if (!TrackingRateLimiter.TryAcquire(GetClientKey(), normalizedCode, out var retryAfter))
        {
            ErrorMessage = L["Tracking_RateLimited", FormatRetryAfter(retryAfter)];
            return;
        }

        var result = await GetPublicTrackingService.GetAsync(normalizedCode);
        if (result.IsFailure)
        {
            ErrorMessage = result.Error.Code switch
            {
                "Application.ValidationFailed" => L["Tracking_ErrorRequired"],
                "Application.NotFound" => L["Tracking_ErrorNotFound"],
                _ => result.Error.Description
            };
            return;
        }

        TrackingResult = result.Value;
        Form.TrackingCode = result.Value.TrackingCode;
    }

    private string GetClientKey()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        return httpContext?.Connection.RemoteIpAddress?.ToString() ?? "unknown-circuit";
    }

    private static string FormatDate(DateTimeOffset value)
    {
        return UiDisplay.FormatLocalDateTime(value);
    }

    private string DisplayOrHidden(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? L["Tracking_Hidden"]
            : value;
    }

    private string FormatRetryAfter(TimeSpan retryAfter)
    {
        var seconds = Math.Max(1, (int)Math.Ceiling(retryAfter.TotalSeconds));
        return L["RetryAfterSeconds", seconds];
    }

    private static string FormatAccessLevel(PublicTrackingAccessLevel accessLevel)
    {
        return accessLevel == PublicTrackingAccessLevel.Verified
            ? "Đã xác minh"
            : "Tóm tắt";
    }

    private static string GetAccessClass(PublicTrackingAccessLevel accessLevel)
    {
        return accessLevel == PublicTrackingAccessLevel.Verified
            ? "verified"
            : "summary";
    }

    private string FormatStatus(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Draft => L["Status_Draft"],
            ShipmentStatus.PendingPickup => L["Status_PendingPickup"],
            ShipmentStatus.Assigned => L["Status_Assigned"],
            ShipmentStatus.PickingUp => L["Status_PickingUp"],
            ShipmentStatus.PickedUp => L["Status_PickedUp"],
            ShipmentStatus.InTransit => L["Status_InTransit"],
            ShipmentStatus.Delivering => L["Status_Delivering"],
            ShipmentStatus.Delivered => L["Status_Delivered"],
            ShipmentStatus.DeliveryFailed => L["Status_DeliveryFailed"],
            ShipmentStatus.Returned => L["Status_Returned"],
            ShipmentStatus.Cancelled => L["Status_Cancelled"],
            _ => status.ToString()
        };
    }

    private string GetTimelineMessage(PublicTrackingTimelineItemResponse item)
    {
        var localizedMessage = L[item.MessageCode];
        return localizedMessage.ResourceNotFound ? item.Message : localizedMessage.Value;
    }

    private static string GetStatusClass(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Delivered => "success",
            ShipmentStatus.Cancelled or ShipmentStatus.DeliveryFailed or ShipmentStatus.Returned => "danger",
            ShipmentStatus.InTransit or ShipmentStatus.Delivering or ShipmentStatus.PickedUp => "info",
            _ => "warning"
        };
    }

    private static int GetProgressStep(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Draft => 0,
            ShipmentStatus.PendingPickup => 0,
            ShipmentStatus.Assigned => 0,
            ShipmentStatus.PickingUp => 0,
            ShipmentStatus.PickedUp => 1,
            ShipmentStatus.InTransit => 2,
            ShipmentStatus.Delivering => 3,
            ShipmentStatus.Delivered => 4,
            _ => 0
        };
    }

    private sealed class TrackingFormModel
    {
        [Required]
        [MaxLength(30)]
        public string TrackingCode { get; set; } = string.Empty;
    }

    private sealed class TrackingVerificationFormModel
    {
        [Required]
        [RegularExpression(@"^\d{4}$", ErrorMessage = "Vui lòng nhập đúng 4 chữ số cuối.")]
        public string PhoneLast4 { get; set; } = string.Empty;
    }
}
