@page "/"
@rendermode InteractiveServer
@layout MiniLogistics.Web.Components.Layout.LandingLayout
@using System.Security.Claims

<PageTitle>LAK | Nền tảng quản lý logistics</PageTitle>

@implements IDisposable

<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="/" aria-label="LAK">
            <img class="brand-logo" src="/images/landing/lak-logo.svg" alt="LAK" />
        </a>

        <nav class="main-nav" aria-label="Main navigation">
            <a href="/">Trang chủ</a>
            <a href="#services">Dịch vụ</a>
            <a href="#about">Về chúng tôi</a>
            <div class="nav-dropdown">
                <button class="nav-dropdown-trigger" type="button" aria-haspopup="menu" aria-expanded="false">
                    Hỗ trợ
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5 1.4 1.4L12 16.8l-6.4-6.4L7 9Z" /></svg>
                </button>
                <div class="nav-dropdown-panel" role="menu">
                    <a href="/contact" role="menuitem">Thông tin liên hệ</a>
                    <a href="/faq" role="menuitem">Câu hỏi thường gặp</a>
                </div>
            </div>
        </nav>

        <div class="header-actions">
            <a class="header-icon-btn" href="/download-app" title="Tải ứng dụng" aria-label="Tải ứng dụng">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
            </a>
            <AuthorizeView Context="authContext">
                <Authorized>
                    <div class="user-menu">
                        <button class="user-menu-trigger" type="button" aria-haspopup="menu" aria-controls="home-user-menu">
                            <img src="/images/landing/lak-logo.svg" alt="" />
                            <span>@(authContext.User.Identity?.Name ?? "Tài khoản")</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5 1.4 1.4L12 16.8l-6.4-6.4L7 9Z" /></svg>
                        </button>
                        <div class="user-menu-panel" id="home-user-menu" role="menu">
                            <a href="@GetWorkspaceUrl(authContext.User)" role="menuitem">Dashboard</a>
                            <form method="post" action="/auth/logout">
                                <AntiforgeryToken />
                                <button type="submit" role="menuitem">Đăng xuất</button>
                            </form>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="header-login-button" href="/login">Đăng nhập</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@using MiniLogistics.Application.Banners
@inject IBannerService BannerService

<main class="landing-main" id="home">
    <section class="hero-banner">
        @if (Banners == null || Banners.Count == 0)
        {
            <img src="/images/landing/hero-banner.png" alt="LAK logistics banner" />
        }
        else
        {
            <div class="lak-carousel">
                @foreach (var (banner, index) in Banners.Select((b, i) => (b, i)))
                {
                    <div class="lak-carousel-item @(index == CurrentBannerIndex ? "active" : "")" style="opacity: @(index == CurrentBannerIndex ? 1 : 0);">
                        @if (!string.IsNullOrWhiteSpace(banner.LinkUrl))
                        {
                            <a href="@banner.LinkUrl" target="_blank" rel="noopener noreferrer">
                                <img src="@banner.ImageUrl" alt="@banner.Title" />
                            </a>
                        }
                        else
                        {
                            <img src="@banner.ImageUrl" alt="@banner.Title" />
                        }
                    </div>
                }
                
                @if (Banners.Count > 1)
                {
                    <div class="lak-carousel-controls">
                        <button type="button" class="lak-carousel-btn" @onclick="PrevBanner" aria-label="Previous banner">❮</button>
                        <button type="button" class="lak-carousel-btn" @onclick="NextBanner" aria-label="Next banner">❯</button>
                    </div>
                    
                    <div class="lak-carousel-indicators">
                        @foreach (var (banner, index) in Banners.Select((b, i) => (b, i)))
                        {
                            <button type="button" class="@(index == CurrentBannerIndex ? "active" : "")" @onclick="() => SetBanner(index)" aria-label="Banner @(index + 1)"></button>
                        }
                    </div>
                }
            </div>
        }
    </section>

    <section class="search-section">
        <div class="container search-wrap">
            <form class="tracking-form" method="get" action="/tracking">
                <input id="tracking-code" name="code" maxlength="30" required placeholder="Nhập mã đơn hàng bạn cần tra cứu" />
                <button type="submit">Theo dõi</button>
            </form>
        </div>
    </section>

    <section class="actions-section">
        <div class="container action-grid">
            <a class="action-card" href="/login">
                <span class="action-card-copy">
                    <strong>Bắt đầu tạo đơn</strong>
                    <span>Tạo đơn lấy hàng hoặc gửi hàng</span>
                </span>
                <span class="action-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6-1.4-1.4 4.6-4.6-4.6-4.6L9 6Z" /></svg>
                </span>
            </a>
            <button type="button" class="action-card">
                <span class="action-card-copy">
                    <strong>Ước tính chi phí</strong>
                    <span>Ước tính phí vận chuyển</span>
                </span>
                <span class="action-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6-1.4-1.4 4.6-4.6-4.6-4.6L9 6Z" /></svg>
                </span>
            </button>
            <button type="button" class="action-card">
                <span class="action-card-copy">
                    <strong>Tra cứu điểm dịch vụ</strong>
                    <span>Gửi hàng tại các điểm dịch vụ</span>
                </span>
                <span class="action-card-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6-1.4-1.4 4.6-4.6-4.6-4.6L9 6Z" /></svg>
                </span>
            </button>
        </div>
    </section>

    <section class="services-section" id="services">
        <div class="container section-narrow">
            <h2>Dịch vụ của LAK</h2>
            <div class="services-grid">
                <article class="service-item">
                    <img src="/images/landing/icon1.svg" alt="" />
                    <h3>Dịch vụ lấy hàng</h3>
                    <p>Hỗ trợ khởi tạo và xử lý yêu cầu lấy hàng rõ ràng.</p>
                </article>
                <article class="service-item">
                    <img src="/images/landing/icon2.svg" alt="" />
                    <h3>Dịch vụ gửi hàng</h3>
                    <p>Quản lý thông tin shop và tạo đơn trong một luồng gọn.</p>
                </article>
                <article class="service-item">
                    <img src="/images/landing/icon3.svg" alt="" />
                    <h3>Dich vu COD</h3>
                    <p>Theo dõi tiền thu hộ và đối soát minh bạch hơn.</p>
                </article>
                <article class="service-item">
                    <img src="/images/landing/icon4.svg" alt="" />
                    <h3>Xử lý vận đơn</h3>
                    <p>Cập nhật trạng thái vận đơn rõ từng mốc nghiệp vụ.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="about-section" id="about">
        <div class="container section-narrow">
            <h2>Về chúng tôi</h2>
            <p class="section-intro">
                LAK hướng tới một giao diện logistics dễ sử dụng hằng ngày: bố cục đơn giản,
                hình ảnh đúng ngữ cảnh và ưu tiên thao tác thực tế thay vì trang trí.
            </p>

            <div class="about-grid">
                <article class="about-card">
                    <img src="/images/landing/hero-banner.png" alt="Nhan vien giao nhan LAK" />
                    <div class="about-copy">
                        <strong>Vận hành rõ ràng</strong>
                        <span>Tập trung vào tạo đơn, tracking và xử lý giao nhận theo một flow dễ quét.</span>
                    </div>
                </article>
                <article class="about-card">
                    <img src="/images/landing/ops-banner.png" alt="He thong kho va xu ly van hanh LAK" />
                    <div class="about-copy">
                        <strong>Sẵn sàng mở rộng</strong>
                        <span>Style này sẽ được dùng tiếp cho tracking, login, shipments và dashboard.</span>
                    </div>
                </article>
            </div>
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="container footer-main">
        <section class="footer-brand" aria-label="LAK Logistics">
            <a href="/" class="footer-brand-link">
                <img src="/images/landing/lak-logo.svg" alt="LAK Logistics" />
            </a>
            <p>Nền tảng quản lý vận chuyển, theo dõi đơn hàng và đối soát COD cho shop.</p>
        </section>

        <nav class="footer-column" aria-label="Vận chuyển">
            <h2>Vận chuyển</h2>
            <a href="/login">Tạo đơn hàng mới</a>
            <a href="/tracking">Tra cứu vận đơn</a>
            <a href="#services">Dịch vụ vận chuyển</a>
            <a href="/register-shop">Đăng ký shop</a>
        </nav>

        <nav class="footer-column" aria-label="Dịch vụ">
            <h2>Dịch vụ</h2>
            <a href="#services">Lấy hàng</a>
            <a href="#services">Gửi hàng</a>
            <a href="#services">Thu tiền hộ COD</a>
            <a href="#services">Xử lý vận đơn</a>
        </nav>

        <nav class="footer-column" aria-label="Đồng hành cùng LAK">
            <h2>Đồng hành cùng LAK</h2>
            <a href="/register-shop">Mở shop cùng LAK</a>
            <a href="#about">Về chúng tôi</a>
            <a href="/login">Đăng nhập hệ thống</a>
        </nav>

        <section class="footer-column footer-contact" aria-label="Trung tâm trợ giúp">
            <h2>Trung tâm trợ giúp</h2>
            <a href="/tracking">Hướng dẫn tra cứu</a>
            <a href="mailto:support@laklogistics.vn">support@laklogistics.vn</a>
            <a href="tel:19006885">1900 6885</a>
        </section>
    </div>

    <div class="container footer-legal">
        <div class="footer-company">
            <strong>LAK Logistics</strong>
            <p>Nền tảng vận hành logistics cho shop và đội điều phối.</p>
            <p>Hỗ trợ: <a href="mailto:support@laklogistics.vn">support@laklogistics.vn</a> · <a href="tel:19006885">1900 6885</a></p>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year LAK Logistics. All rights reserved.</span>
            <span><a href="#about">Chính sách bảo mật</a><span aria-hidden="true">|</span><a href="#about">Điều khoản sử dụng</a></span>
        </div>
    </div>
</footer>

@code {
    private List<BannerDto> Banners = new();
    private int CurrentBannerIndex = 0;
    private System.Threading.Timer? _timer;
    
    protected override async Task OnInitializedAsync()
    {
        var activeBanners = await BannerService.GetActiveBannersAsync();
        Banners = activeBanners.ToList();

        if (Banners.Count > 1)
        {
            _timer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    NextBanner();
                    StateHasChanged();
                });
            }, null, 3000, 3000);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private void NextBanner()
    {
        if (Banners.Count > 1)
        {
            CurrentBannerIndex = (CurrentBannerIndex + 1) % Banners.Count;
        }
    }

    private void PrevBanner()
    {
        if (Banners.Count > 1)
        {
            CurrentBannerIndex = (CurrentBannerIndex - 1 + Banners.Count) % Banners.Count;
        }
    }

    private void SetBanner(int index)
    {
        if (index >= 0 && index < Banners.Count)
        {
            CurrentBannerIndex = index;
        }
    }

    private static string GetWorkspaceUrl(ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin") || user.IsInRole("Operator"))
        {
            return "/operations/assignments";
        }

        if (user.IsInRole("Shipper"))
        {
            return "/shipper/shipments";
        }

        return "/dashboard";
    }
}
