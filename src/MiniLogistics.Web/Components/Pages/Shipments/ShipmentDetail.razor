@page "/shipments/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Shop")]
@using System.Security.Claims
@using MiniLogistics.Application.Shops.GetShopContext
@using MiniLogistics.Application.Shipments
@using MiniLogistics.Application.Shipments.CancelShipmentForCurrentShop
@using MiniLogistics.Application.Shipments.DraftShipments
@using MiniLogistics.Application.Shipments.GetShipmentDetailForCurrentShop
@using MiniLogistics.Domain.Shipments
@using MiniLogistics.Domain.Shops
@inject ICancelShipmentForCurrentShopService CancelShipmentForCurrentShopService
@inject IGetShopContextService GetShopContextService
@inject IGetShipmentDetailForCurrentShopService GetShipmentDetailForCurrentShopService
@inject ISubmitDraftShipmentService SubmitDraftShipmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Shipment detail</PageTitle>

<div class="shipment-detail-page">
    <div class="page-heading">
        <div>
            <a class="back-link" href="@(BuildShopLink("/shipments"))">
                <AppIcon Name="arrow-left" Size="18" />
                <span>Danh sách đơn</span>
            </a>
            <h1>Chi tiết đơn hàng</h1>
            @if (Shipment is not null)
            {
                <p>@Shipment.TrackingCode</p>
            }
        </div>

        @if (Shipment is not null)
        {
            <span class="status-pill @GetStatusClass(Shipment.Status)">
                @FormatStatus(Shipment.Status)
            </span>
        }
    </div>

    @if (ShopContext is not null)
    {
        <section class="shop-context-bar" aria-label="Shop context">
            <label for="shipment-detail-shop-context">
                Shop dang chon
                <select id="shipment-detail-shop-context" value="@SelectedShopId" @onchange="OnShopChanged">
                    @foreach (var shop in ShopContext.Shops)
                    {
                        <option value="@shop.ShopId">
                            @shop.Name@(shop.IsActive ? string.Empty : " (Inactive)")
                        </option>
                    }
                </select>
            </label>
            <span class="shop-context-status @(SelectedShop?.IsActive == true ? "active" : "inactive")">
                @(SelectedShop?.IsActive == true ? "Active" : "Inactive")
            </span>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }
    else if (IsLoading)
    {
        <section class="content-card state-card" aria-live="polite">
            <strong>Đang tải chi tiết đơn hàng</strong>
        </section>
    }
    else if (Shipment is not null)
    {
        @if (!string.IsNullOrWhiteSpace(ActionSuccessMessage))
        {
            <div class="alert alert-success" role="status">@ActionSuccessMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(ActionErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@ActionErrorMessage</div>
        }

        <div class="detail-grid">
            <section class="content-card detail-main">
                <div class="section-heading">
                    <span class="section-icon blue">
                        <AppIcon Name="package" Size="20" />
                    </span>
                    <h2>Thông tin vận đơn</h2>
                </div>

                <dl class="info-grid">
                    <div>
                        <dt>Tracking code</dt>
                        <dd>@Shipment.TrackingCode</dd>
                    </div>
                    <div>
                        <dt>Tuyến đường</dt>
                        <dd>@FormatRouteType(Shipment.RouteType)</dd>
                    </div>
                    <div>
                        <dt>Khối lượng</dt>
                        <dd>@Shipment.WeightKg.ToString("N3") kg</dd>
                    </div>
                    <div>
                        <dt>Kích thước</dt>
                        <dd>@Shipment.ParcelLengthCm.ToString("N2") x @Shipment.ParcelWidthCm.ToString("N2") x @Shipment.ParcelHeightCm.ToString("N2") cm</dd>
                    </div>
                    <div>
                        <dt>Khối lượng quy đổi</dt>
                        <dd>@Shipment.VolumetricWeightKg.ToString("N3") kg</dd>
                    </div>
                    <div>
                        <dt>Cân tính phí</dt>
                        <dd>@Shipment.ChargeableWeightKg.ToString("N3") kg</dd>
                    </div>
                    <div>
                        <dt>Ngày tạo</dt>
                        <dd>@FormatDate(Shipment.CreatedAtUtc)</dd>
                    </div>
                    <div>
                        <dt>Giá trị hàng hóa</dt>
                        <dd>@FormatMoney(Shipment.GoodsValueAmount, Shipment.Currency)</dd>
                    </div>
                    <div>
                        <dt>Phí vận chuyển</dt>
                        <dd>@FormatMoney(Shipment.ShippingFeeAmount, Shipment.Currency)</dd>
                    </div>
                    <div>
                        <dt>Phí dịch vụ chính</dt>
                        <dd>@FormatMoney(Shipment.BaseFeeAmount, Shipment.Currency)</dd>
                    </div>
                    <div>
                        <dt>Phí vượt cân</dt>
                        <dd>@FormatMoney(Shipment.ExtraWeightFeeAmount, Shipment.Currency)</dd>
                    </div>
                    <div>
                        <dt>Phí bảo hiểm</dt>
                        <dd>@FormatMoney(Shipment.InsuranceFeeAmount, Shipment.Currency)</dd>
                    </div>
                    <div>
                        <dt>Phí hoàn hàng</dt>
                        <dd>@FormatMoney(Shipment.ReturnFeeAmount, Shipment.Currency)</dd>
                    </div>
                </dl>

                <div class="party-grid">
                    <article class="party-panel">
                        <h3>Người gửi</h3>
                        <strong>@Shipment.SenderName</strong>
                        <span>@Shipment.SenderPhone</span>
                        <p>@Shipment.PickupAddress.FullAddress</p>
                    </article>

                    <article class="party-panel">
                        <h3>Người nhận</h3>
                        <strong>@Shipment.ReceiverName</strong>
                        <span>@Shipment.ReceiverPhone</span>
                        <p>@Shipment.DeliveryAddress.FullAddress</p>
                    </article>
                </div>

                @if (!string.IsNullOrWhiteSpace(Shipment.Note))
                {
                    <div class="note-panel">
                        <h3>Ghi chú</h3>
                        <p>@Shipment.Note</p>
                    </div>
                }
            </section>

            <aside class="side-stack">
                @if (CanViewCod)
                {
                    <section class="content-card total-card">
                        <span>COD cần thu</span>
                        <strong>@FormatMoney(Shipment.CodAmount, Shipment.Currency)</strong>
                        <small>Vị trí sẵn sàng cho quản lý COD.</small>
                    </section>
                }

                @if (CanViewFullPii && Shipment.Status != ShipmentStatus.Draft)
                {
                    <section class="content-card draft-action-card">
                        <div class="section-heading compact">
                            <span class="section-icon blue">
                                <AppIcon Name="file-text" Size="20" />
                            </span>
                            <h2>Shipping label</h2>
                        </div>

                        <a class="detail-action-link" href="@BuildLabelLink(Shipment.ShipmentId)" target="_blank" rel="noopener">
                            Tai label PDF
                        </a>
                    </section>
                }

                @if (CanManageShipments && CanEditShipment(Shipment.Status))
                {
                    <section class="content-card draft-action-card">
                        <div class="section-heading compact">
                            <span class="section-icon blue">
                                <AppIcon Name="pencil" Size="20" />
                            </span>
                            <h2>Chinh sua don</h2>
                        </div>

                        <a class="detail-action-link" href="@(BuildShopLink($"/shipments/create?shipmentId={Shipment.ShipmentId:D}"))">
                            Sua thong tin
                        </a>

                        @if (Shipment.Status == ShipmentStatus.Draft)
                        {
                            <button type="button" class="submit-draft-button" @onclick="SubmitDraftAsync" disabled="@IsSubmittingDraft">
                                @(IsSubmittingDraft ? "Dang gui don..." : "Gui don")
                            </button>
                        }
                    </section>
                }

                @if (CanManageShipments && CanCancelShipment(Shipment.Status))
                {
                    <section class="content-card cancel-card">
                        <div class="section-heading compact">
                            <span class="section-icon red">
                                <AppIcon Name="x" Size="20" />
                            </span>
                            <h2>Hủy đơn hàng</h2>
                        </div>

                        <form class="cancel-form" @onsubmit="RequestCancelShipment" @onsubmit:preventDefault="true">
                            <label for="cancel-reason">Lý do hủy</label>
                            <textarea id="cancel-reason"
                                      maxlength="500"
                                      required
                                      rows="3"
                                      @bind="CancelReason"
                                      @bind:event="oninput"></textarea>
                            <button type="submit" disabled="@IsCancelling">
                                @(IsCancelling ? "Đang hủy..." : "Xác nhận hủy đơn")
                            </button>
                        </form>
                    </section>
                }

                <section class="content-card">
                    <div class="section-heading compact">
                        <span class="section-icon green">
                            <AppIcon Name="circle-check" Size="20" />
                        </span>
                        <h2>Tracking history</h2>
                    </div>

                    <ol class="timeline">
                        @foreach (var history in Shipment.TrackingHistory)
                        {
                            <li>
                                <span class="timeline-dot"></span>
                                <div>
                                    <strong>@FormatStatus(history.Status)</strong>
                                    <time>@FormatDate(history.ChangedAtUtc)</time>
                                    <small class="timeline-actor">@FormatInternalActor(history)</small>
                                    @if (!string.IsNullOrWhiteSpace(history.Note))
                                    {
                                        <p>@history.Note</p>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                </section>
            </aside>
        </div>
    }
</div>

<ConfirmActionDialog IsOpen="@IsCancelConfirmationOpen"
                     Title="Hủy đơn hàng này?"
                     Message="Đơn sẽ dừng xử lý và không thể khôi phục về trạng thái trước đó."
                     ConfirmText="Hủy đơn hàng"
                     Tone="danger"
                     IsBusy="@IsCancelling"
                     OnConfirm="ConfirmCancelShipmentAsync"
                     OnCancel="CancelCancelConfirmation" />

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "shopId")]
    public Guid? ShopId { get; set; }

    private GetShopContextResponse? ShopContext { get; set; }

    private Guid SelectedShopId { get; set; }

    private ShopContextItemResponse? SelectedShop => ShopContext?.Shops
        .FirstOrDefault(shop => shop.ShopId == SelectedShopId);

    private bool CanManageShipments => SelectedShop?.Permissions.HasFlag(ShopPermission.ManageShipments) == true;

    private bool CanViewFullPii => SelectedShop?.Permissions.HasFlag(ShopPermission.ViewFullPii) == true;

    private bool CanViewCod => SelectedShop?.Permissions.HasFlag(ShopPermission.ViewCod) == true;

    private bool IsLoading { get; set; } = true;

    private bool IsCancelling { get; set; }

    private bool IsSubmittingDraft { get; set; }

    private bool IsCancelConfirmationOpen { get; set; }

    private string? ErrorMessage { get; set; }

    private string? ActionErrorMessage { get; set; }

    private string? ActionSuccessMessage { get; set; }

    private string CancelReason { get; set; } = string.Empty;

    private ShipmentDetailResponse? Shipment { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await LoadShipmentAsync(clearActionMessages: true);
    }

    private async Task LoadShipmentAsync(bool clearActionMessages)
    {
        IsLoading = true;
        ErrorMessage = null;

        if (clearActionMessages)
        {
            ActionErrorMessage = null;
            ActionSuccessMessage = null;
        }

        var userId = await GetCurrentUserIdAsync();
        if (userId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var contextResult = await GetShopContextService.GetAsync(userId.Value, ShopId);
        if (contextResult.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(contextResult.Error);
            Shipment = null;
            IsLoading = false;
            return;
        }

        ShopContext = contextResult.Value;
        SelectedShopId = contextResult.Value.SelectedShopId;

        var result = await GetShipmentDetailForCurrentShopService.GetAsync(userId.Value, Id, SelectedShopId);
        if (result.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(result.Error);
            Shipment = null;
        }
        else
        {
            Shipment = result.Value;
        }

        IsLoading = false;
    }

    private void OnShopChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var shopId))
        {
            NavigationManager.NavigateTo(BuildShopLink("/shipments", shopId));
        }
    }

    private async Task CancelShipmentAsync()
    {
        ActionErrorMessage = null;
        ActionSuccessMessage = null;

        if (string.IsNullOrWhiteSpace(CancelReason))
        {
            ActionErrorMessage = "Vui lòng nhập lý do hủy đơn.";
            return;
        }

        var userId = await GetCurrentUserIdAsync();
        if (userId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        IsCancelling = true;

        var result = await CancelShipmentForCurrentShopService.CancelAsync(new CancelShipmentCommand(
            userId.Value,
            Id,
            CancelReason,
            SelectedShopId));

        IsCancelling = false;

        if (result.IsFailure)
        {
            ActionErrorMessage = UiDisplay.ToErrorMessage(result.Error);
            return;
        }

        CancelReason = string.Empty;
        ActionSuccessMessage = "Đã hủy đơn hàng.";

        await LoadShipmentAsync(clearActionMessages: false);
    }

    private void RequestCancelShipment()
    {
        ActionErrorMessage = null;
        ActionSuccessMessage = null;

        if (string.IsNullOrWhiteSpace(CancelReason))
        {
            ActionErrorMessage = "Vui lòng nhập lý do hủy đơn.";
            return;
        }

        IsCancelConfirmationOpen = true;
    }

    private async Task ConfirmCancelShipmentAsync()
    {
        await CancelShipmentAsync();
        IsCancelConfirmationOpen = false;
    }

    private void CancelCancelConfirmation()
    {
        IsCancelConfirmationOpen = false;
    }

    private async Task SubmitDraftAsync()
    {
        ActionErrorMessage = null;
        ActionSuccessMessage = null;

        var userId = await GetCurrentUserIdAsync();
        if (userId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        IsSubmittingDraft = true;

        var result = await SubmitDraftShipmentService.SubmitAsync(new SubmitDraftShipmentCommand(
            userId.Value,
            Id,
            SelectedShopId));

        IsSubmittingDraft = false;

        if (result.IsFailure)
        {
            ActionErrorMessage = UiDisplay.ToErrorMessage(result.Error);
            return;
        }

        ActionSuccessMessage = result.Value.FeeChanged
            ? $"Da gui don. Phi van chuyen doi tu {FormatMoney(result.Value.PreviousShippingFeeAmount!.Value, result.Value.Currency)} sang {FormatMoney(result.Value.ShippingFeeAmount, result.Value.Currency)}."
            : "Da gui don.";

        await LoadShipmentAsync(clearActionMessages: false);
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdValue = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        return Guid.TryParse(userIdValue, out var userId)
            ? userId
            : null;
    }

    private string BuildShopLink(string path)
    {
        return BuildShopLink(path, SelectedShopId);
    }

    private static string BuildShopLink(string path, Guid shopId)
    {
        return AppendQueryParameter(path, "shopId", shopId == Guid.Empty ? null : shopId.ToString("D"));
    }

    private string BuildLabelLink(Guid shipmentId)
    {
        return BuildShopLink($"/shop/files/shipments/{shipmentId:D}/label.pdf");
    }

    private static string AppendQueryParameter(string url, string name, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return url;
        }

        var separator = url.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return $"{url}{separator}{Uri.EscapeDataString(name)}={Uri.EscapeDataString(value.Trim())}";
    }

    private static string FormatDate(DateTimeOffset value)
    {
        return UiDisplay.FormatLocalDateTime(value);
    }

    private static string FormatInternalActor(ShipmentStatusHistoryResponse history)
    {
        if (!history.ChangedByUserFound)
        {
            return "Cập nhật bởi người dùng không xác định";
        }

        return string.IsNullOrWhiteSpace(history.ChangedByEmail)
            ? $"Cập nhật bởi {history.ChangedByDisplayName}"
            : $"Cập nhật bởi {history.ChangedByDisplayName} ({history.ChangedByEmail})";
    }

    private static string FormatMoney(decimal amount, string currency)
    {
        return $"{amount.ToString("N0")} {currency}";
    }

    private static string FormatRouteType(RouteType routeType)
    {
        return routeType switch
        {
            RouteType.IntraProvince => "Nội tỉnh",
            RouteType.IntraRegion => "Nội vùng",
            RouteType.InterRegion => "Liên vùng",
            _ => routeType.ToString()
        };
    }

    private static string FormatStatus(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.PendingPickup => "Chờ lấy hàng",
            ShipmentStatus.Assigned => "Đã phân công",
            ShipmentStatus.PickingUp => "Đang lấy hàng",
            ShipmentStatus.PickedUp => "Đã lấy hàng",
            ShipmentStatus.InTransit => "Đang vận chuyển",
            ShipmentStatus.Delivering => "Đang giao",
            ShipmentStatus.Delivered => "Đã giao",
            ShipmentStatus.DeliveryFailed => "Giao thất bại",
            ShipmentStatus.Returned => "Đã hoàn",
            ShipmentStatus.Cancelled => "Đã hủy",
            ShipmentStatus.Draft => "Draft",
            _ => status.ToString()
        };
    }

    private static string GetStatusClass(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Delivered => "success",
            ShipmentStatus.Cancelled or ShipmentStatus.DeliveryFailed or ShipmentStatus.Returned => "danger",
            ShipmentStatus.InTransit or ShipmentStatus.Delivering or ShipmentStatus.PickedUp => "info",
            _ => "warning"
        };
    }

    private static bool CanCancelShipment(ShipmentStatus status)
    {
        return status is ShipmentStatus.Draft
            or ShipmentStatus.PendingPickup
            or ShipmentStatus.Assigned
            or ShipmentStatus.PickingUp;
    }

    private static bool CanEditShipment(ShipmentStatus status)
    {
        return status is ShipmentStatus.Draft or ShipmentStatus.PendingPickup;
    }
}
