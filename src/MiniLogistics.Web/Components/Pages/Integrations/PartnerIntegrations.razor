@page "/partner/integrations"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Shop,Admin,IntegrationAdmin")]
@using System.Security.Claims
@using MiniLogistics.Application.PartnerApi
@using MiniLogistics.Domain.PartnerApi
@inject IApiClientManagementService ApiClientManagementService
@inject IWebhookManagementService WebhookManagementService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<PartnerIntegrations> Logger

<PageTitle>Partner integrations - MiniLogistics</PageTitle>

<div class="partner-integrations-page">
    <UiPageHeader Eyebrow="Partner API"
                  Title="Tích hợp đối tác"
                  Description="Quản lý quyền truy cập API, webhook và độ tin cậy của luồng dữ liệu với website bên thứ ba."
                  Icon="webhook">
        <Actions>
            <button type="button" class="ui-button ui-button--secondary" disabled="@IsLoading" @onclick="RefreshAsync">
                <AppIcon Name="refresh" Size="18" />
                <span>Làm mới</span>
            </button>
        </Actions>
    </UiPageHeader>

    <UiAlert Message="@ErrorMessage" Tone="danger" />
    <UiAlert Message="@SuccessMessage" Tone="success" />

    @if (!string.IsNullOrWhiteSpace(GeneratedApiKey))
    {
        <section class="content-card secret-card">
            <div>
                <p class="eyebrow">API key mới</p>
                <h2>Lưu khóa truy cập an toàn</h2>
                <p>Khóa gốc chỉ được hiển thị một lần sau khi tạo hoặc xoay vòng.</p>
            </div>
            <div class="secret-row">
                <code>@GeneratedApiKey</code>
                <button type="button" class="ui-button ui-button--secondary ui-button--compact" @onclick="CopyGeneratedKeyAsync">Sao chép</button>
            </div>
        </section>
    }

    @if (IsLoading)
    {
        <UiLoadingState Title="Đang tải cấu hình tích hợp" Description="Đang kiểm tra API client, webhook và lịch sử delivery." />
    }
    else if (Dashboard.Shops.Count == 0)
    {
        <section class="content-card state-card">
            <strong>Chưa có shop khả dụng</strong>
            <p>Cần kích hoạt shop trước khi cấp API key cho website bên thứ ba.</p>
        </section>
    }
    else
    {
        <section class="content-card create-section">
            @if (Dashboard.GranularPermissionEnabled)
            {
                <div class="scope-banner" role="status">
                    Granular integration permission dang bat. Danh sach shop va action chi nam trong scope cua tai khoan hien tai.
                </div>
            }

            <div class="section-heading">
                <div>
                    <p class="eyebrow">API client</p>
                    <h2>Tao API key</h2>
                </div>
            </div>

            <form class="create-client-form" @onsubmit="CreateApiClientAsync" @onsubmit:preventDefault="true">
                <label class="field-group" for="integration-shop">
                    <span>Shop</span>
                    <select id="integration-shop" value="@SelectedShopId" @onchange="OnShopChangedAsync">
                        @foreach (var shop in Dashboard.Shops)
                        {
                            <option value="@shop.ShopId">
                                @shop.ShopName@(shop.IsActive ? string.Empty : " (Inactive)")
                            </option>
                        }
                    </select>
                </label>

                <label class="field-group" for="api-client-name">
                    <span>Ten ung dung</span>
                    <input id="api-client-name" maxlength="150" required @bind="CreateClientName" @bind:event="oninput" />
                </label>

                <fieldset class="scope-checkboxes">
                    <legend>API scopes</legend>
                    @foreach (var scope in AvailableScopes)
                    {
                        <label><input type="checkbox" checked="@CreateScopes.HasFlag(scope)" @onchange="args => ToggleCreateScope(scope, args)" /> @scope</label>
                    }
                </fieldset>

                <label class="field-group" for="api-client-ips">
                    <span>IP whitelist (optional)</span>
                    <textarea id="api-client-ips" rows="2" placeholder="203.0.113.10, 2001:db8::1" @bind="CreateAllowedIps"></textarea>
                </label>

                <label class="field-group" for="api-client-expiry">
                    <span>Expires on (optional)</span>
                    <input id="api-client-expiry" type="date" value="@CreateExpiresDate" @onchange="args => CreateExpiresDate = args.Value?.ToString() ?? string.Empty" />
                </label>

                <div class="form-actions">
                    <button type="submit" class="primary-button" disabled="@(IsCreatingClient || !CanManageSelectedShop)">
                        @(IsCreatingClient ? "Dang tao..." : "Tao API key")
                    </button>
                </div>
            </form>
        </section>

        @if (!CanManageSelectedShop)
        {
            <div class="alert-box danger" role="status">
                Shop dang inactive. Ban co the xem integration hien co, nhung khong the tao key, rotate, revoke hoac cap nhat webhook.
            </div>
        }

        <section class="content-card clients-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Danh sach</p>
                    <h2>API clients</h2>
                </div>
                <span class="section-count">@VisibleClients.Count.ToString("N0") client</span>
            </div>

            @if (VisibleClients.Count == 0)
            {
                <div class="state-card compact">
                    <strong>Shop nay chua co API client</strong>
                    <p>Tao API key de website ban hang co the goi quote va tao shipment.</p>
                </div>
            }
            else
            {
                <div class="table-shell">
                    <table class="clients-table">
                        <thead>
                            <tr>
                                <th>Client</th>
                                <th>Shop</th>
                                <th>Key prefix</th>
                                <th>Trang thai</th>
                                <th>Lan dung cuoi</th>
                                <th>Thao tac</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var client in VisibleClients)
                            {
                                <tr class="@(client.ApiClientId == SelectedClientId ? "selected-row" : null)">
                                    <td data-label="Client">
                                        <button type="button" class="text-button" @onclick="() => SelectClient(client.ApiClientId)">
                                            @client.Name
                                        </button>
                                        <small>@client.ApiClientId.ToString()[..8]</small>
                                    </td>
                                    <td data-label="Shop">@client.ShopName</td>
                                    <td data-label="Key prefix"><code>@client.ApiKeyPrefix</code></td>
                                    <td data-label="Trang thai">
                                        <span class="status-pill @(client.IsActive ? "active" : "inactive")">
                                            @(client.IsActive ? "Active" : "Revoked")
                                        </span>
                                    </td>
                                    <td data-label="Lan dung cuoi">@FormatNullableDate(client.LastUsedAtUtc)</td>
                                    <td data-label="Thao tac">
                                        <div class="row-actions">
                                            <button type="button" class="secondary-button" disabled="@(IsBusy || !CanManageSelectedShop)" @onclick="() => RotateClientAsync(client.ApiClientId)">
                                                Rotate
                                            </button>
                                            <button type="button"
                                                    class="toggle-button @(client.IsActive ? "danger" : "success")"
                                                    disabled="@(IsBusy || !CanManageSelectedShop)"
                                                    @onclick="() => ToggleClientAsync(client)">
                                                @(client.IsActive ? "Revoke" : "Kich hoat")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (SelectedClient is not null)
        {
            <section class="content-card webhook-metrics-section">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Webhook monitoring</p>
                        <h2>Health cua @SelectedClient.Name</h2>
                    </div>
                    <span class="section-count">@SelectedClient.WebhookMetrics.TotalDeliveries.ToString("N0") delivery gan nhat</span>
                </div>

                <div class="metrics-grid">
                    <article>
                        <span>Success rate</span>
                        <strong>@SelectedClient.WebhookMetrics.SuccessRate.ToString("N2")%</strong>
                    </article>
                    <article>
                        <span>Avg latency</span>
                        <strong>@FormatLatency(SelectedClient.WebhookMetrics.AverageLatencyMs)</strong>
                    </article>
                    <article>
                        <span>Failed</span>
                        <strong>@SelectedClient.WebhookMetrics.FailedDeliveries.ToString("N0")</strong>
                    </article>
                    <article>
                        <span>Retry queue</span>
                        <strong>@SelectedClient.WebhookMetrics.PendingRetryDeliveries.ToString("N0")</strong>
                    </article>
                </div>

                @if (SelectedClient.Usage is not null)
                {
                    <div class="metrics-grid usage-grid">
                        <article><span>Requests / 7 days</span><strong>@SelectedClient.Usage.TotalRequests.ToString("N0")</strong></article>
                        <article><span>Successful</span><strong>@SelectedClient.Usage.SuccessfulRequests.ToString("N0")</strong></article>
                        <article><span>Errors</span><strong>@SelectedClient.Usage.FailedRequests.ToString("N0")</strong></article>
                        <article><span>Last hour</span><strong>@(SelectedClient.Usage.Hourly.LastOrDefault()?.RequestCount ?? 0)</strong></article>
                    </div>
                    <div class="usage-buckets">
                        <div>
                            <h3>Requests by day</h3>
                            @foreach (var bucket in SelectedClient.Usage.Daily)
                            {
                                <p><time>@bucket.BucketUtc.ToString("yyyy-MM-dd")</time><strong>@bucket.RequestCount</strong><span>@bucket.ErrorCount error</span></p>
                            }
                        </div>
                        <div>
                            <h3>Requests by hour (24h)</h3>
                            @foreach (var bucket in SelectedClient.Usage.Hourly.TakeLast(8))
                            {
                                <p><time>@bucket.BucketUtc.ToString("MM-dd HH:00")</time><strong>@bucket.RequestCount</strong><span>@bucket.ErrorCount error</span></p>
                            }
                        </div>
                    </div>
                    @if (SelectedClient.Usage.LatestFailedRequests.Count > 0)
                    {
                        <div class="latest-errors">
                            @foreach (var request in SelectedClient.Usage.LatestFailedRequests.Take(5))
                            {
                                <p><code>@request.StatusCode</code> <strong>@request.Method @request.Path</strong> <span>@(request.ErrorCode ?? "Request failed")</span></p>
                            }
                        </div>
                    }
                }
            </section>

            <section class="integration-grid">
                <article class="content-card security-card">
                    <div class="section-heading"><div><p class="eyebrow">Access policy</p><h2>Scopes, IP va expiry</h2></div></div>
                    <form class="webhook-form" @onsubmit="SaveSecurityAsync" @onsubmit:preventDefault="true">
                        <fieldset class="scope-checkboxes">
                            <legend>Allowed scopes</legend>
                            @foreach (var scope in AvailableScopes)
                            {
                                <label><input type="checkbox" checked="@SecurityScopes.HasFlag(scope)" @onchange="args => ToggleSecurityScope(scope, args)" /> @scope</label>
                            }
                        </fieldset>
                        <label class="field-group"><span>IP whitelist</span><textarea rows="3" @bind="SecurityAllowedIps"></textarea></label>
                        <label class="field-group"><span>Expires on</span><input type="date" value="@SecurityExpiresDate" @onchange="args => SecurityExpiresDate = args.Value?.ToString() ?? string.Empty" /></label>
                        @if (SelectedClient.ExpiresAtUtc.HasValue && SelectedClient.ExpiresAtUtc.Value <= DateTimeOffset.UtcNow.AddDays(14))
                        {
                            <div class="alert-box danger">API key sap het han vao @FormatDate(SelectedClient.ExpiresAtUtc.Value).</div>
                        }
                        <button type="submit" class="primary-button" disabled="@(IsSavingSecurity || !CanManageSelectedShop)">Luu access policy</button>
                    </form>
                </article>

                <article class="content-card webhook-card">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">Webhook</p>
                            <h2>Cau hinh endpoint</h2>
                        </div>
                        <span class="status-pill @(SelectedClient.WebhookEndpoint?.IsActive == true ? "active" : "inactive")">
                            @(SelectedClient.WebhookEndpoint?.IsActive == true ? "Active" : "Not configured")
                        </span>
                    </div>

                    <form class="webhook-form" @onsubmit="SaveWebhookAsync" @onsubmit:preventDefault="true">
                        <label class="field-group" for="webhook-url">
                            <span>Webhook URL</span>
                            <input id="webhook-url" type="url" maxlength="500" required disabled="@(!CanManageSelectedShop)" placeholder="https://store.example.com/webhooks/logistics" @bind="WebhookUrl" @bind:event="oninput" />
                        </label>

                        <label class="field-group" for="webhook-secret">
                            <span>Signing secret</span>
                            <input id="webhook-secret" maxlength="200" required disabled="@(!CanManageSelectedShop)" @bind="WebhookSigningSecret" @bind:event="oninput" />
                        </label>

                        <div class="form-actions split-actions">
                            <button type="submit" class="primary-button" disabled="@(IsSavingWebhook || !CanManageSelectedShop)">
                                @(IsSavingWebhook ? "Dang luu..." : "Luu webhook")
                            </button>
                            <button type="button" class="secondary-button" disabled="@(IsTestingWebhook || !CanManageSelectedShop)" @onclick="TestWebhookAsync">
                                @(IsTestingWebhook ? "Dang test..." : "Test webhook")
                            </button>
                        </div>
                    </form>
                </article>

                <article class="content-card delivery-section">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">Delivery log</p>
                            <h2>Lich su webhook</h2>
                        </div>
                        <span class="section-count">@SelectedClient.RecentDeliveries.Count.ToString("N0") event</span>
                    </div>

                    @if (SelectedClient.RecentDeliveries.Count == 0)
                    {
                        <div class="state-card compact">
                            <strong>Chua co delivery</strong>
                            <p>Gui test webhook hoac cap nhat shipment de tao event.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-shell compact-table">
                            <table class="deliveries-table">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Status</th>
                                        <th>HTTP</th>
                                        <th>Latency</th>
                                        <th>Retry</th>
                                        <th>Last attempt</th>
                                        <th>Error</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var delivery in SelectedClient.RecentDeliveries)
                                    {
                                        <tr>
                                            <td data-label="Event">
                                                <strong>@delivery.EventType</strong>
                                                <small>@FormatDate(delivery.CreatedAtUtc)</small>
                                            </td>
                                            <td data-label="Status">
                                                <span class="status-pill @GetDeliveryStatusClass(delivery.Status)">
                                                    @delivery.Status
                                                </span>
                                            </td>
                                            <td data-label="HTTP">@(delivery.LastResponseStatusCode?.ToString() ?? "-")</td>
                                            <td data-label="Latency">@FormatLatency(delivery.LastDurationMs)</td>
                                            <td data-label="Retry">@delivery.RetryCount</td>
                                            <td data-label="Last attempt">@FormatNullableDate(delivery.LastAttemptAtUtc)</td>
                                            <td data-label="Error" class="error-cell">@(delivery.LastError ?? "-")</td>
                                            <td data-label="Action">
                                                @if (delivery.Status == WebhookDeliveryStatus.DeadLettered
                                                    || (delivery.Status == WebhookDeliveryStatus.Failed && !delivery.NextAttemptAtUtc.HasValue))
                                                {
                                                    <button type="button" class="secondary-button" disabled="@IsBusy" @onclick="() => RetryDeliveryAsync(delivery.WebhookDeliveryId)">Retry</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>

                <article class="content-card delivery-section">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">Outbox recovery</p>
                            <h2>Event chua tao delivery</h2>
                        </div>
                        <span class="section-count">@SelectedOutboxFailures.Count.ToString("N0") event loi</span>
                    </div>

                    @if (SelectedOutboxFailures.Count == 0)
                    {
                        <div class="state-card compact">
                            <strong>Khong co outbox loi</strong>
                            <p>Cac event webhook da duoc chuyen sang delivery queue.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-shell compact-table">
                            <table class="deliveries-table">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Status</th>
                                        <th>Retry</th>
                                        <th>Created</th>
                                        <th>Error</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var failure in SelectedOutboxFailures)
                                    {
                                        <tr>
                                            <td data-label="Event"><strong>@failure.EventType</strong></td>
                                            <td data-label="Status"><span class="status-pill danger">@failure.Status</span></td>
                                            <td data-label="Retry">@failure.RetryCount</td>
                                            <td data-label="Created">@FormatDate(failure.CreatedAtUtc)</td>
                                            <td data-label="Error" class="error-cell">@failure.Error</td>
                                            <td data-label="Action">
                                                <button type="button" class="secondary-button" disabled="@IsBusy" @onclick="() => RetryOutboxAsync(failure.OutboxMessageId)">Retry</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>

                <article class="content-card audit-section">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">Security audit</p>
                            <h2>Lich su key/webhook</h2>
                        </div>
                        <span class="section-count">@SelectedClient.RecentCredentialAudits.Count.ToString("N0") action</span>
                    </div>

                    @if (SelectedClient.RecentCredentialAudits.Count == 0)
                    {
                        <div class="state-card compact">
                            <strong>Chua co audit action</strong>
                            <p>Cac thao tac tao key, rotate, revoke, webhook se xuat hien tai day.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-shell compact-table">
                            <table class="audit-table">
                                <thead>
                                    <tr>
                                        <th>Action</th>
                                        <th>Result</th>
                                        <th>Actor</th>
                                        <th>Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var audit in SelectedClient.RecentCredentialAudits)
                                    {
                                        <tr>
                                            <td data-label="Action">
                                                <strong>@FormatAuditAction(audit.Action)</strong>
                                                @if (!string.IsNullOrWhiteSpace(audit.ErrorCode))
                                                {
                                                    <small>@audit.ErrorCode</small>
                                                }
                                            </td>
                                            <td data-label="Result">
                                                <span class="status-pill @GetAuditStatusClass(audit.IsSuccess)">
                                                    @(audit.IsSuccess ? "Success" : "Failed")
                                                </span>
                                            </td>
                                            <td data-label="Actor"><code>@audit.ActorUserId.ToString()[..8]</code></td>
                                            <td data-label="Time">@FormatDate(audit.OccurredAtUtc)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            </section>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "shopId")]
    public Guid? ShopId { get; set; }

    private PartnerIntegrationDashboardResponse Dashboard { get; set; } = new([], []);

    private bool IsLoading { get; set; } = true;

    private bool IsCreatingClient { get; set; }

    private bool IsSavingWebhook { get; set; }

    private bool IsTestingWebhook { get; set; }

    private bool IsSavingSecurity { get; set; }

    private bool IsRetryingDelivery { get; set; }

    private bool IsRetryingOutbox { get; set; }

    private bool IsBusy => IsCreatingClient || IsSavingWebhook || IsTestingWebhook || IsSavingSecurity || IsRetryingDelivery || IsRetryingOutbox;

    private Guid SelectedShopId { get; set; }

    private PartnerIntegrationShopResponse? SelectedShop => Dashboard.Shops
        .FirstOrDefault(shop => shop.ShopId == SelectedShopId);

    private IReadOnlyList<PartnerOutboxFailureResponse> SelectedOutboxFailures =>
        Dashboard.OutboxFailures?
            .Where(failure => failure.ApiClientId == SelectedClientId)
            .ToList() ?? [];

    private bool CanManageSelectedShop => SelectedShop?.IsActive == true;

    private Guid? SelectedClientId { get; set; }

    private string CreateClientName { get; set; } = "Default partner app";

    private PartnerApiScope CreateScopes { get; set; } = PartnerApiScope.All;

    private string CreateAllowedIps { get; set; } = string.Empty;

    private string CreateExpiresDate { get; set; } = string.Empty;

    private PartnerApiScope SecurityScopes { get; set; } = PartnerApiScope.All;

    private string SecurityAllowedIps { get; set; } = string.Empty;

    private string SecurityExpiresDate { get; set; } = string.Empty;

    private string WebhookUrl { get; set; } = string.Empty;

    private string WebhookSigningSecret { get; set; } = string.Empty;

    private string? GeneratedApiKey { get; set; }

    private string? ErrorMessage { get; set; }

    private string? SuccessMessage { get; set; }

    private IReadOnlyList<PartnerApiClientResponse> VisibleClients => Dashboard.ApiClients
        .Where(client => client.ShopId == SelectedShopId)
        .OrderBy(client => client.Name)
        .ToList();

    private PartnerApiClientResponse? SelectedClient => Dashboard.ApiClients
        .FirstOrDefault(client => client.ApiClientId == SelectedClientId);

    private static readonly PartnerApiScope[] AvailableScopes =
    [
        PartnerApiScope.Quote,
        PartnerApiScope.CreateShipment,
        PartnerApiScope.TrackShipment,
        PartnerApiScope.CancelShipment,
        PartnerApiScope.WebhookManage
    ];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync(clearMessages: true);
    }

    private async Task RefreshAsync()
    {
        GeneratedApiKey = null;
        await LoadAsync(clearMessages: true);
    }

    private async Task LoadAsync(bool clearMessages)
    {
        IsLoading = true;
        ErrorMessage = null;

        if (clearMessages)
        {
            SuccessMessage = null;
        }

        try
        {
            var currentUserId = await GetCurrentUserIdAsync();
            if (currentUserId is null)
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            var previousShopId = ShopId ?? SelectedShopId;
            var previousClientId = SelectedClientId;
            var result = await WebhookManagementService.GetDashboardAsync(currentUserId.Value);
            if (result.IsFailure)
            {
                ErrorMessage = UiDisplay.ToErrorMessage(result.Error);
                Dashboard = new([], []);
                SelectedShopId = Guid.Empty;
                SelectedClientId = null;
                return;
            }

            Dashboard = result.Value;
            SelectedShopId = Dashboard.Shops.Any(shop => shop.ShopId == previousShopId)
                ? previousShopId
                : Dashboard.Shops.FirstOrDefault()?.ShopId ?? Guid.Empty;
            SelectedClientId = Dashboard.ApiClients.Any(client => client.ApiClientId == previousClientId)
                ? previousClientId
                : VisibleClients.FirstOrDefault()?.ApiClientId;
            SyncWebhookForm();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the partner integration dashboard.");
            Dashboard = new([], []);
            SelectedShopId = Guid.Empty;
            SelectedClientId = null;
            ErrorMessage = "Khong the tai cau hinh Partner API. Vui long thu lai; neu loi tiep dien, kiem tra ket noi database va server log.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CreateApiClientAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        GeneratedApiKey = null;

        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        IsCreatingClient = true;
        var result = await ApiClientManagementService.CreateApiClientAsync(new CreatePartnerApiClientCommand(
            currentUserId.Value,
            SelectedShopId,
            CreateClientName,
            CreateScopes,
            ParseIpAddresses(CreateAllowedIps),
            ParseExpiry(CreateExpiresDate)));
        IsCreatingClient = false;

        if (result.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(result.Error);
            return;
        }

        GeneratedApiKey = result.Value.ApiKey;
        SelectedClientId = result.Value.ApiClientId;
        SuccessMessage = "Da tao API client.";
        CreateClientName = "Default partner app";
        CreateScopes = PartnerApiScope.All;
        CreateAllowedIps = string.Empty;
        CreateExpiresDate = string.Empty;
        await LoadAsync(clearMessages: false);
    }

    private async Task RotateClientAsync(Guid apiClientId)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        GeneratedApiKey = null;

        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var result = await ApiClientManagementService.RotateApiClientKeyAsync(new RotatePartnerApiClientKeyCommand(
            currentUserId.Value,
            apiClientId));
        if (result.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(result.Error);
            return;
        }

        GeneratedApiKey = result.Value.ApiKey;
        SelectedClientId = apiClientId;
        SuccessMessage = "Da rotate API key.";
        await LoadAsync(clearMessages: false);
    }

    private async Task ToggleClientAsync(PartnerApiClientResponse client)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        GeneratedApiKey = null;

        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var targetStatus = !client.IsActive;
        var result = await ApiClientManagementService.SetApiClientActiveStatusAsync(new SetPartnerApiClientActiveStatusCommand(
            currentUserId.Value,
            client.ApiClientId,
            targetStatus));
        if (result.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(result.Error);
            return;
        }

        SelectedClientId = client.ApiClientId;
        SuccessMessage = targetStatus ? "Da kich hoat API client." : "Da revoke API client.";
        await LoadAsync(clearMessages: false);
    }

    private async Task SaveWebhookAsync()
    {
        if (SelectedClientId is null)
        {
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;
        GeneratedApiKey = null;

        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        IsSavingWebhook = true;
        var result = await WebhookManagementService.UpsertWebhookEndpointAsync(new UpsertPartnerWebhookEndpointCommand(
            currentUserId.Value,
            SelectedClientId.Value,
            WebhookUrl,
            WebhookSigningSecret));
        IsSavingWebhook = false;

        if (result.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(result.Error);
            return;
        }

        SuccessMessage = "Da luu webhook endpoint.";
        await LoadAsync(clearMessages: false);
    }

    private async Task TestWebhookAsync()
    {
        if (SelectedClientId is null)
        {
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;
        GeneratedApiKey = null;

        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
