    private async Task SaveSecurityAsync()
    {
        if (SelectedClientId is null) return;
        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId is null) return;
        IsSavingSecurity = true;
        var result = await ApiClientManagementService.UpdateApiClientSecurityAsync(
            new UpdatePartnerApiClientSecurityCommand(
                currentUserId.Value,
                SelectedClientId.Value,
                SecurityScopes,
                ParseIpAddresses(SecurityAllowedIps),
                ParseExpiry(SecurityExpiresDate)));
        IsSavingSecurity = false;
        if (result.IsFailure) { ErrorMessage = UiDisplay.ToErrorMessage(result.Error); return; }
        SuccessMessage = "Da cap nhat access policy.";
        await LoadAsync(clearMessages: false);
    }

    private async Task RetryDeliveryAsync(Guid deliveryId)
    {
        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId is null) return;
        IsRetryingDelivery = true;
        var result = await WebhookManagementService.RetryWebhookDeliveryAsync(
            new RetryPartnerWebhookDeliveryCommand(currentUserId.Value, deliveryId));
        IsRetryingDelivery = false;
        if (result.IsFailure) { ErrorMessage = UiDisplay.ToErrorMessage(result.Error); return; }
        SuccessMessage = "Da dua webhook delivery vao retry queue.";
        await LoadAsync(clearMessages: false);
    }

    private async Task RetryOutboxAsync(Guid outboxMessageId)
    {
        var currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId is null) return;
        IsRetryingOutbox = true;
        var result = await WebhookManagementService.RetryOutboxMessageAsync(
            new RetryPartnerOutboxMessageCommand(currentUserId.Value, outboxMessageId));
        IsRetryingOutbox = false;
