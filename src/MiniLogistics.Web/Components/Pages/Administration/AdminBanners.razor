@page "/admin/banners"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using MiniLogistics.Application.Banners
@inject IBannerService BannerService
@inject IWebHostEnvironment Environment

<PageTitle>Quản lý Banner - LAK Logistics</PageTitle>

<div class="admin-banners-page">
    <header class="admin-hero">
        <div>
            <p class="eyebrow">Marketing & Giao diện</p>
            <h1>Quản lý Banner</h1>
            <p>Tải ảnh từ thiết bị, cấu hình thứ tự và quản lý hiển thị các banner truyền thông trên hệ thống.</p>
        </div>
        <button type="button" class="refresh-button" disabled="@IsLoading" @onclick="() => LoadAsync()">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor">
                <path d="M12 5a7 7 0 1 1-6.3 4H3.5A9 9 0 1 0 6 5.8V3H4v6h6V7H7.4A7 7 0 0 1 12 5Z" />
            </svg>
            <span>Làm mới</span>
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert-box danger" role="alert">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
            </svg>
            <span>@ErrorMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert-box success" role="status">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
            </svg>
            <span>@SuccessMessage</span>
        </div>
    }

    <section class="summary-grid" aria-label="Thống kê banner">
        <article class="metric-card">
            <span>Tổng số banner</span>
            <strong>@Banners.Count.ToString("N0")</strong>
            <small>Tất cả banner trong hệ thống</small>
        </article>
        <article class="metric-card success">
            <span>Đang hiển thị (Active)</span>
            <strong>@Banners.Count(b => b.IsActive).ToString("N0")</strong>
            <small>Hiển thị ngoài trang chủ</small>
        </article>
        <article class="metric-card warning">
            <span>Tạm dừng (Inactive)</span>
            <strong>@Banners.Count(b => !b.IsActive).ToString("N0")</strong>
            <small>Đang ẩn khỏi khách hàng</small>
        </article>
    </section>

    <div class="banners-layout">
        <!-- Form Panel -->
        <section class="admin-panel banner-editor">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">@(EditingBannerId.HasValue ? "Biên tập" : "Thêm mới")</p>
                    <h2>@(EditingBannerId.HasValue ? "Chỉnh sửa banner" : "Tạo banner mới")</h2>
                </div>
                @if (EditingBannerId.HasValue)
                {
                    <button type="button" class="secondary-button" @onclick="() => ClearForm()">+ Tạo mới</button>
                }
            </div>

            <form class="banner-form" @onsubmit="SaveBannerAsync" @onsubmit:preventDefault="true">
                <div class="field-group">
                    <label for="banner-title">Tiêu đề banner <span class="required">*</span></label>
                    <input id="banner-title" class="form-input" maxlength="200" required placeholder="Ví dụ: Khuyến mãi mùa lễ hội, Dịch vụ hỏa tốc..." @bind="Title" @bind:event="oninput" />
                    <span class="field-hint">Tiêu đề mô tả giúp quản lý và làm thẻ alt cho hình ảnh.</span>
                </div>

                <div class="field-group">
                    <label>Hình ảnh banner (Tối đa 5MB) <span class="required">*</span></label>

                    @if (string.IsNullOrWhiteSpace(ImageUrl))
                    {
                        <div class="upload-dropzone @(IsUploading ? "uploading" : "")">
                            <InputFile id="banner-file-input" class="file-input-hidden" OnChange="HandleFileSelected" accept=".png,.jpg,.jpeg,.webp,.svg,.gif" disabled="@IsUploading" />
                            <label for="banner-file-input" class="dropzone-label">
                                <div class="dropzone-icon">
                                    <svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor">
                                        <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" />
                                    </svg>
                                </div>
                                <strong>@(IsUploading ? "Đang tải ảnh lên..." : "Chọn ảnh từ thiết bị hoặc kéo thả vào đây")</strong>
                                <span>Hỗ trợ JPG, PNG, WEBP, SVG, GIF (Dung lượng tối đa 5MB)</span>
                            </label>
                        </div>
                    }
                    else
                    {
                        <div class="image-preview-card">
                            <div class="preview-wrapper">
                                <img src="@ImageUrl" alt="@(string.IsNullOrWhiteSpace(Title) ? "Banner preview" : Title)" class="preview-img" />
                            </div>
                            <div class="preview-info">
                                <div class="preview-meta">
                                    <strong>@(SelectedFileName ?? "Ảnh banner")</strong>
                                    @if (SelectedFileSize > 0)
                                    {
                                        <span class="file-size">@FormatFileSize(SelectedFileSize)</span>
                                    }
                                </div>
                                <div class="preview-actions">
                                    <label for="banner-file-change" class="secondary-button compact-btn">
                                        Đổi ảnh khác
                                        <InputFile id="banner-file-change" class="file-input-hidden" OnChange="HandleFileSelected" accept=".png,.jpg,.jpeg,.webp,.svg,.gif" disabled="@IsUploading" />
                                    </label>
                                    <button type="button" class="danger-button compact-btn" @onclick="RemoveImage">Xóa ảnh</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="field-group">
                    <label for="banner-link">Đường dẫn liên kết (Link URL - Tùy chọn)</label>
                    <input id="banner-link" class="form-input" maxlength="1000" type="url" placeholder="https://example.com/khuyen-mai hoặc /services" @bind="LinkUrl" @bind:event="oninput" />
                    <span class="field-hint">Người dùng sẽ được chuyển đến trang này khi bấm vào banner.</span>
                </div>

                <div class="form-row-grid">
                    <div class="field-group">
                        <label for="banner-sort">Thứ tự hiển thị <span class="required">*</span></label>
                        <input id="banner-sort" class="form-input" type="number" required min="0" @bind="SortOrder" @bind:event="oninput" />
                        <span class="field-hint">Số nhỏ hơn sẽ hiển thị trước.</span>
                    </div>

                    <div class="field-group checkbox-field">
                        <label class="switch-control">
                            <input type="checkbox" @bind="IsActive" />
                            <span class="switch-slider"></span>
                            <span class="switch-label">Kích hoạt banner ngay</span>
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    @if (EditingBannerId.HasValue)
                    {
                        <button type="button" class="secondary-button" @onclick="() => ClearForm()">Hủy sửa</button>
                    }
                    <button type="submit" class="primary-button" disabled="@(IsLoading || IsUploading || string.IsNullOrWhiteSpace(Title) || string.IsNullOrWhiteSpace(ImageUrl))">
                        @(IsLoading ? "Đang lưu..." : (EditingBannerId.HasValue ? "Cập nhật banner" : "Lưu banner"))
                    </button>
                </div>
            </form>
        </section>

        <!-- List Panel -->
        <section class="admin-panel banner-list-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Danh sách</p>
                    <h2>Các banner hiện có (@Banners.Count)</h2>
                </div>
            </div>

            @if (IsLoading && Banners.Count == 0)
            {
                <div class="state-card" aria-live="polite">
                    <p>Đang tải danh sách banner...</p>
                </div>
            }
            else if (Banners.Count == 0)
            {
                <div class="state-card empty-card">
                    <svg viewBox="0 0 24 24" width="48" height="48" fill="#94a3b8" aria-hidden="true">
                        <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                    </svg>
                    <h3>Chưa có banner nào</h3>
                    <p>Hãy tải ảnh từ thiết bị và lưu lại để hiển thị banner trên trang chủ.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="banners-table">
                        <thead>
                            <tr>
                                <th class="col-sort">Thứ tự</th>
                                <th class="col-thumb">Ảnh</th>
                                <th class="col-title">Tiêu đề & Đường dẫn</th>
                                <th class="col-status">Trạng thái</th>
                                <th class="col-actions">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var banner in Banners.OrderBy(b => b.SortOrder))
                            {
                                <tr class="@(banner.IsActive ? "" : "inactive-row")">
                                    <td class="col-sort">
                                        <span class="sort-badge">@banner.SortOrder</span>
                                    </td>
                                    <td class="col-thumb">
                                        <div class="table-img-wrapper">
                                            <img src="@banner.ImageUrl" alt="@banner.Title" loading="lazy" />
                                        </div>
                                    </td>
                                    <td class="col-title">
                                        <strong class="banner-table-title">@banner.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(banner.LinkUrl))
                                        {
                                            <a href="@banner.LinkUrl" target="_blank" rel="noopener noreferrer" class="banner-link-preview">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                                                    <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" />
                                                </svg>
                                                <span>@banner.LinkUrl</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="no-link-text">Không có liên kết</span>
                                        }
                                    </td>
                                    <td class="col-status">
                                        @if (banner.IsActive)
                                        {
                                            <span class="status-pill success">Đang hiển thị</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill warning">Tạm dừng</span>
                                        }
                                    </td>
                                    <td class="col-actions">
                                        <div class="actions-group">
                                            <button type="button" class="action-btn edit" @onclick="() => EditBanner(banner)" title="Chỉnh sửa banner" aria-label="Chỉnh sửa">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                                                </svg>
                                            </button>
                                            <button type="button" class="action-btn toggle" @onclick="() => RequestToggleStatus(banner)" title="@(banner.IsActive ? "Tạm dừng" : "Kích hoạt")" aria-label="Đổi trạng thái">
                                                @if (banner.IsActive)
                                                {
                                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                                        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                                        <path d="M8 5v14l11-7z" />
                                                    </svg>
                                                }
                                            </button>
                                            <button type="button" class="action-btn delete" @onclick="() => RequestDeleteBanner(banner)" title="Xóa banner" aria-label="Xóa">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                                    <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

<ConfirmActionDialog IsOpen="@(PendingBannerAction is not null)"
                     Title="@PendingBannerActionTitle"
                     Message="@PendingBannerActionMessage"
                     ConfirmText="@PendingBannerActionConfirmText"
                     Tone="@PendingBannerActionTone"
                     IsBusy="@IsConfirmingBannerAction"
                     OnConfirm="ConfirmBannerActionAsync"
                     OnCancel="CancelBannerAction" />

@code {
    private const long MaxFileSize = 5 * 1024 * 1024; // 5 MB

    private bool IsLoading;
    private bool IsUploading;
    private string? ErrorMessage;
    private string? SuccessMessage;

    private List<BannerDto> Banners = new();

    private Guid? EditingBannerId;
    private string Title = string.Empty;
    private string ImageUrl = string.Empty;
    private string? LinkUrl;
    private int SortOrder = 0;
    private bool IsActive = true;
    private string? SelectedFileName;
    private long SelectedFileSize;

    private PendingBannerActionRequest? PendingBannerAction;
    private bool IsBannerActionBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(bool clearMessages = true)
    {
        IsLoading = true;
        ErrorMessage = null;
        if (clearMessages)
        {
            SuccessMessage = null;
        }
        StateHasChanged();

        try
        {
            var result = await BannerService.GetAllBannersAsync();
            Banners = result.ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Lỗi khi tải danh sách banner: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        var file = e.File;
        if (file is null) return;

        if (file.Size > MaxFileSize)
        {
            ErrorMessage = "Kích thước ảnh vượt quá giới hạn cho phép (tối đa 5MB). Vui lòng chọn tệp nhỏ hơn.";
            return;
        }

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowedExtensions = new[] { ".png", ".jpg", ".jpeg", ".webp", ".svg", ".gif" };
        if (!allowedExtensions.Contains(extension))
        {
            ErrorMessage = "Định dạng tệp không hợp lệ. Vui lòng tải lên hình ảnh định dạng PNG, JPG, JPEG, WEBP, SVG hoặc GIF.";
            return;
        }

        IsUploading = true;
        StateHasChanged();

        try
        {
            var uploadsFolder = Path.Combine(Environment.WebRootPath, "images", "banners");
            if (!Directory.Exists(uploadsFolder))
            {
                Directory.CreateDirectory(uploadsFolder);
            }

            var uniqueFileName = $"banner_{DateTime.UtcNow:yyyyMMdd_HHmmss}_{Guid.NewGuid().ToString("N")[..8]}{extension}";
            var destinationPath = Path.Combine(uploadsFolder, uniqueFileName);

            await using var stream = file.OpenReadStream(MaxFileSize);
            await using var targetStream = File.Create(destinationPath);
            await stream.CopyToAsync(targetStream);

            ImageUrl = $"/images/banners/{uniqueFileName}";
            SelectedFileName = file.Name;
            SelectedFileSize = file.Size;
            SuccessMessage = "Đã tải ảnh lên thành công.";

            if (string.IsNullOrWhiteSpace(Title))
            {
                Title = Path.GetFileNameWithoutExtension(file.Name);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Lỗi khi tải ảnh lên: " + ex.Message;
        }
        finally
        {
            IsUploading = false;
            StateHasChanged();
        }
    }

    private void RemoveImage()
    {
        ImageUrl = string.Empty;
        SelectedFileName = null;
        SelectedFileSize = 0;
    }

    private void EditBanner(BannerDto banner)
    {
        EditingBannerId = banner.Id;
        Title = banner.Title;
        ImageUrl = banner.ImageUrl;
        LinkUrl = banner.LinkUrl;
        SortOrder = banner.SortOrder;
        IsActive = banner.IsActive;
        SelectedFileName = Path.GetFileName(banner.ImageUrl);
        SelectedFileSize = 0;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void ClearForm(bool clearMessages = true)
    {
        EditingBannerId = null;
        Title = string.Empty;
        ImageUrl = string.Empty;
        LinkUrl = null;
        SelectedFileName = null;
        SelectedFileSize = 0;
        SortOrder = Banners.Count > 0 ? Banners.Max(b => b.SortOrder) + 1 : 0;
        IsActive = true;
        if (clearMessages)
        {
            ErrorMessage = null;
            SuccessMessage = null;
        }
    }

    private async Task SaveBannerAsync()
    {
        if (string.IsNullOrWhiteSpace(Title) || string.IsNullOrWhiteSpace(ImageUrl))
        {
            ErrorMessage = "Vui lòng nhập tiêu đề và tải lên hình ảnh cho banner.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            if (EditingBannerId.HasValue)
            {
                await BannerService.UpdateBannerAsync(EditingBannerId.Value, Title.Trim(), ImageUrl.Trim(), string.IsNullOrWhiteSpace(LinkUrl) ? null : LinkUrl.Trim(), SortOrder);
                SuccessMessage = "Cập nhật banner thành công.";
            }
            else
            {
                await BannerService.CreateBannerAsync(Title.Trim(), ImageUrl.Trim(), string.IsNullOrWhiteSpace(LinkUrl) ? null : LinkUrl.Trim(), SortOrder, IsActive);
                SuccessMessage = "Tạo banner mới thành công.";
            }

            await LoadAsync(clearMessages: false);
            ClearForm(clearMessages: false);
        }
        catch (Exception ex)
        {
            ErrorMessage = "Lỗi khi lưu banner: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ToggleStatusAsync(Guid id)
    {
        try
        {
            await BannerService.ToggleBannerStatusAsync(id);
            SuccessMessage = "Đã cập nhật trạng thái hiển thị của banner.";
            await LoadAsync(clearMessages: false);
        }
        catch (Exception ex)
        {
            ErrorMessage = "Lỗi khi cập nhật trạng thái: " + ex.Message;
        }
    }

    private async Task DeleteBannerAsync(Guid id)
    {
        try
        {
            await BannerService.DeleteBannerAsync(id);
            SuccessMessage = "Xóa banner thành công.";
            if (EditingBannerId == id)
            {
                ClearForm(clearMessages: false);
            }
            await LoadAsync(clearMessages: false);
        }
        catch (Exception ex)
        {
            ErrorMessage = "Lỗi khi xóa banner: " + ex.Message;
        }
    }

    private void RequestToggleStatus(BannerDto banner)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        PendingBannerAction = new PendingBannerActionRequest(banner, BannerActionKind.ToggleStatus);
    }

    private void RequestDeleteBanner(BannerDto banner)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        PendingBannerAction = new PendingBannerActionRequest(banner, BannerActionKind.Delete);
    }

    private async Task ConfirmBannerActionAsync()
    {
        if (PendingBannerAction is null) return;

        IsBannerActionBusy = true;
        try
        {
            var action = PendingBannerAction;
            if (action.Kind == BannerActionKind.Delete)
            {
                await DeleteBannerAsync(action.Banner.Id);
            }
            else
            {
                await ToggleStatusAsync(action.Banner.Id);
            }
        }
        finally
        {
            IsBannerActionBusy = false;
            PendingBannerAction = null;
        }
    }

    private void CancelBannerAction()
    {
        PendingBannerAction = null;
    }

    private bool IsConfirmingBannerAction => IsBannerActionBusy;

    private string PendingBannerActionTitle => PendingBannerAction?.Kind switch
    {
        BannerActionKind.Delete => "Xác nhận xóa banner?",
        _ when PendingBannerAction?.Banner.IsActive == true => "Tạm dừng hiển thị banner?",
        _ => "Kích hoạt hiển thị banner?"
    };

    private string PendingBannerActionMessage => PendingBannerAction?.Kind switch
    {
        BannerActionKind.Delete => $"Banner “{PendingBannerAction.Banner.Title}” sẽ bị xóa vĩnh viễn khỏi hệ thống.",
        _ when PendingBannerAction?.Banner.IsActive == true => $"Banner “{PendingBannerAction.Banner.Title}” sẽ tạm dừng và không còn hiển thị ở trang chủ.",
        _ => $"Banner “{PendingBannerAction?.Banner.Title}” sẽ được kích hoạt và xuất hiện trên trang chủ."
    };

    private string PendingBannerActionConfirmText => PendingBannerAction?.Kind switch
    {
        BannerActionKind.Delete => "Xác nhận xóa",
        _ when PendingBannerAction?.Banner.IsActive == true => "Tạm dừng",
        _ => "Kích hoạt"
    };

    private string PendingBannerActionTone => PendingBannerAction?.Kind == BannerActionKind.Delete || PendingBannerAction?.Banner.IsActive == true
        ? "danger"
        : "primary";

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private enum BannerActionKind
    {
        ToggleStatus,
        Delete
    }

    private sealed record PendingBannerActionRequest(BannerDto Banner, BannerActionKind Kind);
}
