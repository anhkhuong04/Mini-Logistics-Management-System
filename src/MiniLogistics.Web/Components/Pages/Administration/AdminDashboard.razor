@page "/admin"
@page "/admin/dashboard"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using System.Security.Claims
@using MiniLogistics.Application.AdminDashboard
@inject IGetAdminDashboardService GetAdminDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Admin Dashboard - MiniLogistics</PageTitle>

<div class="admin-dashboard-page">
    <UiPageHeader Eyebrow="Trung tâm điều hành"
                  Title="Tổng quan hệ thống"
                  Description="Theo dõi vận hành, năng lực giao hàng, dòng tiền COD và sức khỏe tích hợp đối tác."
                  Icon="activity">
        <Actions>
            <button type="button" class="ui-button ui-button--secondary" disabled="@IsLoading" @onclick="LoadAsync">
                <AppIcon Name="refresh" Size="18" />
                <span>@(IsLoading ? "Đang tải" : "Làm mới")</span>
            </button>
        </Actions>
    </UiPageHeader>

    <UiAlert Message="@ErrorMessage" Tone="danger" />

    <section class="admin-panel dashboard-filters">
        <label class="field-group" for="dashboard-from">
            <span>Từ ngày</span>
            <input id="dashboard-from" type="date" value="@FromDateText" @onchange="OnFromDateChanged" />
        </label>

        <label class="field-group" for="dashboard-to">
            <span>Đến ngày</span>
            <input id="dashboard-to" type="date" value="@ToDateText" @onchange="OnToDateChanged" />
        </label>

        <label class="field-group" for="dashboard-province">
            <span>Tỉnh / thành phố</span>
            <input id="dashboard-province" placeholder="Tất cả khu vực" @bind="ProvinceFilter" @bind:event="oninput" />
        </label>

        <div class="form-actions">
            <button type="button" class="ui-button ui-button--primary" disabled="@IsLoading" @onclick="LoadAsync">Áp dụng</button>
        </div>
    </section>

    @if (IsLoading)
    {
        <UiLoadingState Title="Đang tổng hợp dữ liệu" Description="Số liệu vận hành mới nhất đang được cập nhật." />
    }
    else if (Dashboard is not null)
    {
        <section class="summary-grid" aria-label="Admin dashboard metrics">
            <UiMetricCard Label="Đơn tạo trong kỳ" Value="@Dashboard.Shipments.Created.ToString("N0")" Note="Không bao gồm đơn nháp" Icon="package" Href="/operations/assignments" />
            <UiMetricCard Label="Chờ phân công" Value="@Dashboard.Shipments.PendingPickupUnassigned.ToString("N0")" Note="Cần phân công hoặc thử lại" Icon="clock" Tone="warning" Href="/operations/assignments" />
            <UiMetricCard Label="Giao thất bại" Value="@Dashboard.Shipments.DeliveryFailed.ToString("N0")" Note="@($"{Dashboard.Shipments.DeliveryFailedRate:N2}% tổng đơn hợp lệ")" Icon="alert" Tone="danger" Href="/operations/assignments" />
            <UiMetricCard Label="Shipper hoạt động" Value="@Dashboard.Shippers.Active.ToString("N0")" Note="@($"{Dashboard.Shippers.AvailableForAssignment:N0} sẵn sàng nhận đơn")" Icon="truck" Href="/admin/users" />
            <UiMetricCard Label="Vượt công suất" Value="@Dashboard.Shippers.OverCapacity.ToString("N0")" Note="Theo tải phân công hiện tại" Icon="users" Tone="warning" Href="/admin/users" />
            <UiMetricCard Label="Shop hoạt động" Value="@Dashboard.Shops.Active.ToString("N0")" Note="@($"{Dashboard.Shops.Inactive:N0} shop đang tạm ngưng")" Icon="store" Href="/admin/shops" />
        </section>

        <section class="dashboard-grid">
            <article class="admin-panel dashboard-card">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">COD</p>
                        <h2>Dòng tiền thu hộ</h2>
                    </div>
                    <a class="panel-link" href="/admin/cod">Mở quản lý COD</a>
                </div>

                <div class="stacked-metrics">
                    <div>
                        <span>Chờ thu</span>
                        <strong>@FormatMoney(Dashboard.Cod.PendingCollectionAmount, Dashboard.Cod.Currency)</strong>
                        <small>@Dashboard.Cod.PendingCollectionCount.ToString("N0") đơn</small>
                    </div>
                    <div>
                        <span>Chờ đối soát</span>
                        <strong>@FormatMoney(Dashboard.Cod.CollectedAwaitingSettlementAmount, Dashboard.Cod.Currency)</strong>
                        <small>@Dashboard.Cod.CollectedAwaitingSettlementCount.ToString("N0") đơn</small>
                    </div>
                    <div>
                        <span>Đã đối soát</span>
                        <strong>@FormatMoney(Dashboard.Cod.SettledAmount, Dashboard.Cod.Currency)</strong>
                        <small>@Dashboard.Cod.SettledCount.ToString("N0") đơn</small>
                    </div>
                </div>
            </article>

            <article class="admin-panel dashboard-card">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">Webhook</p>
                        <h2>Sức khỏe tích hợp</h2>
                    </div>
                    <a class="panel-link" href="/partner/integrations">Quản lý API</a>
                </div>

                <div class="stacked-metrics compact">
                    <div>
                        <span>Gửi thất bại</span>
                        <strong>@Dashboard.Webhooks.Failed.ToString("N0")</strong>
                    </div>
                    <div>
                        <span>Đang chờ thử lại</span>
                        <strong>@Dashboard.Webhooks.RetryPending.ToString("N0")</strong>
                    </div>
                </div>
            </article>
        </section>
    }
</div>

@code {
    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private string FromDateText { get; set; } = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private string ToDateText { get; set; } = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private string ProvinceFilter { get; set; } = string.Empty;

    private AdminDashboardResponse? Dashboard { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        var adminUserId = await GetCurrentUserIdAsync();
        if (adminUserId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var result = await GetAdminDashboardService.GetAsync(new AdminDashboardQuery(
            adminUserId.Value,
            ParseStartDate(FromDateText),
            ParseEndDate(ToDateText),
            string.IsNullOrWhiteSpace(ProvinceFilter) ? null : ProvinceFilter.Trim()));

        IsLoading = false;
        if (result.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(result.Error);
            Dashboard = null;
            return;
        }

        Dashboard = result.Value;
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdValue = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        return Guid.TryParse(userIdValue, out var userId)
            ? userId
            : null;
    }

    private void OnFromDateChanged(ChangeEventArgs args)
    {
        FromDateText = args.Value?.ToString() ?? string.Empty;
    }

    private void OnToDateChanged(ChangeEventArgs args)
    {
        ToDateText = args.Value?.ToString() ?? string.Empty;
    }

    private static DateTimeOffset? ParseStartDate(string value)
    {
        return DateOnly.TryParse(value, out var date)
            ? date.ToDateTime(TimeOnly.MinValue, DateTimeKind.Local).ToUniversalTime()
            : null;
    }

    private static DateTimeOffset? ParseEndDate(string value)
    {
        return DateOnly.TryParse(value, out var date)
            ? date.ToDateTime(TimeOnly.MaxValue, DateTimeKind.Local).ToUniversalTime()
            : null;
    }

    private static string FormatMoney(decimal amount, string currency)
    {
        return $"{amount:N0} {currency}";
    }
}
