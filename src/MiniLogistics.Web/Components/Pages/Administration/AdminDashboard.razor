@page "/admin"
@page "/admin/dashboard"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using System.Security.Claims
@using MiniLogistics.Application.AdminDashboard
@inject IGetAdminDashboardService GetAdminDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Tổng quan hệ thống - MiniLogistics</PageTitle>

<div class="admin-dashboard-page" aria-busy="@IsLoading">
    <UiPageHeader Title="Tổng quan hệ thống" Description="Ưu tiên đơn cần xử lý và theo dõi tiền thu hộ." Icon="layout-dashboard">
        <Actions>
            <button type="button" class="ui-button ui-button--secondary" disabled="@IsLoading" @onclick="LoadAsync"><AppIcon Name="refresh" Size="18" /> Làm mới</button>
            <a href="/operations/assignments" class="ui-button ui-button--primary"><AppIcon Name="truck" Size="18" /> Điều phối giao nhận</a>
        </Actions>
    </UiPageHeader>

    <section class="dashboard-filters" aria-label="Bộ lọc tổng quan hệ thống">
        <div class="date-presets" aria-label="Chọn nhanh khoảng ngày">
            <button type="button" disabled="@IsLoading" @onclick="() => ApplyPresetAsync(1)">Hôm nay</button>
            <button type="button" disabled="@IsLoading" @onclick="() => ApplyPresetAsync(7)">7 ngày</button>
            <button type="button" disabled="@IsLoading" @onclick="() => ApplyPresetAsync(30)">30 ngày</button>
        </div>
        <label class="field-group" for="dashboard-from"><span>Từ ngày</span><input id="dashboard-from" type="date" value="@FromDateText" @onchange="OnFromDateChanged" disabled="@IsLoading" /></label>
        <label class="field-group" for="dashboard-to"><span>Đến ngày</span><input id="dashboard-to" type="date" value="@ToDateText" @onchange="OnToDateChanged" disabled="@IsLoading" /></label>
        <label class="field-group province-field" for="dashboard-province"><span>Tỉnh / thành phố</span><input id="dashboard-province" placeholder="Tất cả khu vực" @bind="ProvinceFilter" @bind:event="oninput" disabled="@IsLoading" /></label>
        <button type="button" class="ui-button ui-button--secondary" disabled="@(IsLoading || DateRangeError is not null)" @onclick="LoadAsync">Áp dụng</button>
    </section>
    @if (DateRangeError is not null) { <p class="filter-error" role="alert">@DateRangeError</p> }
    <UiAlert Message="@ErrorMessage" Tone="danger" />

    @if (IsLoading)
    {
        <UiLoadingState Title="Đang tải tổng quan" Description="Đang cập nhật số liệu vận hành." />
    }
    else if (Dashboard is not null)
    {
        <p class="dataset-period">Đơn tạo từ @Dashboard.FromUtc.ToLocalTime().ToString("dd/MM/yyyy") đến @Dashboard.ToUtc.ToLocalTime().ToString("dd/MM/yyyy") · @(Dashboard.Province ?? "Tất cả khu vực")</p>
        <section class="summary-grid" aria-label="Tóm tắt vận hành">
            <UiMetricCard Label="Đơn tạo trong kỳ" Value="@Dashboard.Shipments.Created.ToString("N0")" Note="Không bao gồm đơn nháp" Icon="package" Href="/operations/assignments" />
            <UiMetricCard Label="Chờ phân công" Value="@Dashboard.Shipments.PendingPickupUnassigned.ToString("N0")" Note="Cần phân công shipper" Icon="clock" Tone="warning" Href="/operations/assignments" />
            <UiMetricCard Label="Giao thất bại" Value="@Dashboard.Shipments.DeliveryFailed.ToString("N0")" Note="@($"{Dashboard.Shipments.DeliveryFailedRate:N1}% đơn trong kỳ")" Icon="triangle-alert" Tone="danger" Href="/operations/assignments" />
            <UiMetricCard Label="Shipper nhận đơn" Value="@Dashboard.Shippers.AvailableForAssignment.ToString("N0")" Note="Đã bật trạng thái sẵn sàng" Icon="truck" Href="/admin/users" />
        </section>

        <section class="dashboard-grid">
            <article class="admin-panel">
                <div class="panel-heading"><h2>Tiền thu hộ</h2><a href="/admin/cod">Quản lý COD <AppIcon Name="arrow-right" Size="16" /></a></div>
                <div class="cod-flow">
                    <div><span>Chờ thu</span><strong>@FormatMoney(Dashboard.Cod.PendingCollectionAmount, Dashboard.Cod.Currency)</strong><small>@Dashboard.Cod.PendingCollectionCount.ToString("N0") đơn</small></div>
                    <div><span>Chờ đối soát</span><strong>@FormatMoney(Dashboard.Cod.CollectedAwaitingSettlementAmount, Dashboard.Cod.Currency)</strong><small>@Dashboard.Cod.CollectedAwaitingSettlementCount.ToString("N0") đơn</small></div>
                    <div><span>Đã đối soát</span><strong>@FormatMoney(Dashboard.Cod.SettledAmount, Dashboard.Cod.Currency)</strong><small>@Dashboard.Cod.SettledCount.ToString("N0") đơn</small></div>
                </div>
            </article>
            <article class="admin-panel">
                <div class="panel-heading"><h2>Năng lực vận hành</h2></div>
                <dl class="capacity-list">
                    <div><dt>Shipper đang hoạt động</dt><dd><a href="/admin/users">@Dashboard.Shippers.Active.ToString("N0")</a></dd></div>
                    <div><dt>Shipper vượt công suất</dt><dd class="@(Dashboard.Shippers.OverCapacity > 0 ? "needs-attention" : null)"><a href="/admin/users">@Dashboard.Shippers.OverCapacity.ToString("N0")</a></dd></div>
                    <div><dt>Shop đang hoạt động</dt><dd><a href="/admin/shops">@Dashboard.Shops.Active.ToString("N0")</a></dd></div>
                    <div><dt>Shop tạm ngưng</dt><dd><a href="/admin/shops">@Dashboard.Shops.Inactive.ToString("N0")</a></dd></div>
                </dl>
                <p class="panel-note">Số liệu hiện tại. Shipper toàn hệ thống; Shop theo khu vực đã chọn.</p>
            </article>
        </section>
        <section class="admin-panel integration-summary">
            <div class="integration-label"><AppIcon Name="webhook" Size="20" /><h2>Tích hợp đối tác</h2></div>
            <div class="integration-counts"><span><strong>@Dashboard.Webhooks.Failed.ToString("N0")</strong> gửi thất bại</span><span><strong>@Dashboard.Webhooks.RetryPending.ToString("N0")</strong> chờ thử lại</span></div>
            <a href="/partner/integrations">Kiểm tra tích hợp <AppIcon Name="arrow-right" Size="16" /></a>
        </section>
    }
</div>

@code {
    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private string FromDateText { get; set; } = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private string ToDateText { get; set; } = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private string ProvinceFilter { get; set; } = string.Empty;

    private AdminDashboardResponse? Dashboard { get; set; }

    private string? DateRangeError => DashboardPresentation.DateRangeError(FromDateText, ToDateText);

    private Task ApplyPresetAsync(int days)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        FromDateText = today.AddDays(1 - days).ToString("yyyy-MM-dd");
        ToDateText = today.ToString("yyyy-MM-dd");
        return LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (DateRangeError is not null) return;
        IsLoading = true;
        ErrorMessage = null;

        var adminUserId = await GetCurrentUserIdAsync();
        if (adminUserId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var result = await GetAdminDashboardService.GetAsync(new AdminDashboardQuery(
            adminUserId.Value,
            ParseStartDate(FromDateText),
            ParseEndDate(ToDateText),
            string.IsNullOrWhiteSpace(ProvinceFilter) ? null : ProvinceFilter.Trim()));

        IsLoading = false;
        if (result.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(result.Error);
            Dashboard = null;
            return;
        }

        Dashboard = result.Value;
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdValue = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        return Guid.TryParse(userIdValue, out var userId)
            ? userId
            : null;
    }

    private void OnFromDateChanged(ChangeEventArgs args)
    {
        FromDateText = args.Value?.ToString() ?? string.Empty;
    }

    private void OnToDateChanged(ChangeEventArgs args)
    {
        ToDateText = args.Value?.ToString() ?? string.Empty;
    }

    private static DateTimeOffset? ParseStartDate(string value)
    {
        return DateOnly.TryParse(value, out var date)
            ? date.ToDateTime(TimeOnly.MinValue, DateTimeKind.Local).ToUniversalTime()
            : null;
    }

    private static DateTimeOffset? ParseEndDate(string value)
    {
        return DateOnly.TryParse(value, out var date)
            ? date.ToDateTime(TimeOnly.MaxValue, DateTimeKind.Local).ToUniversalTime()
            : null;
    }

    private static string FormatMoney(decimal amount, string currency)
    {
        return $"{amount:N0} {currency}";
    }
}
