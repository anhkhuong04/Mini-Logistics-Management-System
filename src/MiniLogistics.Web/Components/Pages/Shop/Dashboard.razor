@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Shop")]
@using System.Security.Claims
@using MiniLogistics.Application.Shops.GetShopContext
@using MiniLogistics.Application.Shops.Reports
@using MiniLogistics.Application.Shipments.GetShipmentsForCurrentShop
@using MiniLogistics.Domain.Shipments
@using MiniLogistics.Domain.Shops
@inject IGetShopContextService GetShopContextService
@inject IGetShopDashboardKpiService GetShopDashboardKpiService
@inject IGetShipmentsForCurrentShopService GetShipmentsForCurrentShopService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Shop Dashboard - MiniLogistics</PageTitle>

<div class="dashboard-page">
    <UiPageHeader Eyebrow="Tổng quan cửa hàng"
                  Title="@ShopDisplayName"
                  Description="Theo dõi đơn hàng, hiệu suất giao nhận và dòng tiền theo khoảng thời gian đã chọn."
                  Icon="store">
        <Actions>
            @if (CanManageShipments)
            {
                <a class="ui-button ui-button--primary" href="@(BuildShopLink("/shipments/create"))">
                    <AppIcon Name="plus" Size="18" />
                    <span>Tạo đơn mới</span>
                </a>
            }
            <a class="ui-button ui-button--secondary" href="/tracking">
                <AppIcon Name="search" Size="18" />
                <span>Tra cứu</span>
            </a>
            <a class="ui-button ui-button--secondary" href="@(BuildShopLink("/shipments"))">
                <AppIcon Name="package" Size="18" />
                <span>Danh sách đơn</span>
            </a>
        </Actions>
    </UiPageHeader>

    @if (ShopContext is not null)
    {
        <section class="shop-context-bar" aria-label="Shop context">
            <label for="dashboard-shop-context">
                Shop đang chọn
                <select id="dashboard-shop-context" value="@SelectedShopId" @onchange="OnShopChanged">
                    @foreach (var shop in ShopContext.Shops)
                    {
                        <option value="@shop.ShopId">
                            @shop.Name@(shop.IsActive ? string.Empty : " (Inactive)")
                        </option>
                    }
                </select>
            </label>
            <span class="shop-context-status @(SelectedShop?.IsActive == true ? "active" : "inactive")">
                @(SelectedShop?.IsActive == true ? "Active" : "Inactive")
            </span>
        </section>

        <section class="dashboard-filter-bar" aria-label="Dashboard filters">
            <label>
                Từ ngày
                <input type="date" value="@FromDateInput" @onchange="args => FromDateInput = args.Value?.ToString() ?? string.Empty" />
            </label>
            <label>
                Đến ngày
                <input type="date" value="@ToDateInput" @onchange="args => ToDateInput = args.Value?.ToString() ?? string.Empty" />
            </label>
            <button type="button" class="secondary-action compact" @onclick="ApplyDateRangeAsync" disabled="@IsLoading">
                Áp dụng
            </button>
            <button type="button" class="secondary-action compact" @onclick="ClearDateRangeAsync" disabled="@(!HasDateRange || IsLoading)">
                Đặt lại
            </button>
            @if (CanViewCod)
            {
                <a class="secondary-action compact" href="@(BuildShopLink("/shop/cod-report"))">
                    Báo cáo COD
                </a>
            }
        </section>
    }

    <UiAlert Message="@ErrorMessage" Tone="danger" />

    @if (IsLoading)
    {
        <UiLoadingState Title="Đang tải dashboard" Description="Đang tổng hợp đơn hàng và KPI mới nhất của shop." />
    }
    else
    {
        <section class="stats-grid" aria-label="Shop statistics">
            @foreach (var card in StatisticCards)
            {
                <UiMetricCard Label="@card.Label" Value="@card.Value" Note="@card.Note" Icon="@card.Icon" Tone="@card.Tone" />
            }
        </section>

        <section class="dashboard-card latest-orders">
            <div class="card-header">
                <h2>Đơn hàng mới nhất</h2>
                <a class="card-link" href="@(BuildShopLink("/shipments"))">Xem tất cả</a>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Tracking</th>
                            <th>Người nhận</th>
                            <th>Tuyến</th>
                            <th>Cân tính phí</th>
                            <th>Trạng thái</th>
                            @if (CanViewCod)
                            {
                                <th>COD</th>
                            }
                            <th>Phí vận chuyển</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (LatestShipments.Count == 0)
                        {
                            <tr>
                                <td colspan="@(CanViewCod ? 9 : 8)">
                                    <div class="empty-state">
                                        <span>
                                            <AppIcon Name="package" Size="18" />
                                        </span>
                                        <strong>Chưa có đơn hàng để hiển thị</strong>
                                        <p>Tạo vận đơn đầu tiên để dashboard tự động cập nhật số liệu.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var shipment in LatestShipments)
                            {
                                <tr>
                                    <td>
                                        <a class="tracking-link" href="@(BuildShopLink($"/shipments/{shipment.ShipmentId}"))">
                                            @shipment.TrackingCode
                                        </a>
                                    </td>
                                    <td>@shipment.ReceiverName</td>
                                    <td>@FormatRouteType(shipment.RouteType)</td>
                                    <td>@shipment.ChargeableWeightKg.ToString("N3") kg</td>
                                    <td>
                                        <span class="status-pill @GetStatusClass(shipment.Status)">
                                            @FormatStatus(shipment.Status)
                                        </span>
                                    </td>
                                    @if (CanViewCod)
                                    {
                                        <td>@FormatMoney(shipment.CodAmount, shipment.Currency)</td>
                                    }
                                    <td>@FormatMoney(shipment.ShippingFeeAmount, shipment.Currency)</td>
                                    <td>@FormatDate(shipment.CreatedAtUtc)</td>
                                    <td>
                                        <a class="icon-link" href="@(BuildShopLink($"/shipments/{shipment.ShipmentId}"))" aria-label="Xem chi tiet">
                                            <AppIcon Name="chevron-right" Size="18" />
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <a class="view-all" href="@(BuildShopLink(LatestShipments.Count == 0 && CanManageShipments ? "/shipments/create" : "/shipments"))">
                @(LatestShipments.Count == 0 && CanManageShipments ? "Tạo đơn hàng đầu tiên" : "Mở danh sách đơn hàng")
            </a>
        </section>

        <section class="dashboard-bottom">
            <article class="dashboard-card status-card">
                <div class="card-header">
                    <h2>Đơn hàng theo trạng thái</h2>
                    <a class="card-link" href="@(BuildShopLink("/shipments"))">Xem chi tiết</a>
                </div>

                <div class="status-content">
                    <div class="donut-empty">
                        <strong>@(DashboardKpi?.TotalShipments ?? 0)</strong>
                        <span>Tổng đơn</span>
                    </div>

                    <div class="status-list">
                        @foreach (var status in StatusRows)
                        {
                            <div class="status-row">
                                <span class="status-dot @status.ClassName"></span>
                                <p>@status.Label</p>
                                <div class="status-bar"><span style="@($"width: {status.Percentage:N0}%")"></span></div>
                                <strong>@status.Count</strong>
                            </div>
                        }
                    </div>
                </div>
            </article>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "shopId")]
    public Guid? ShopId { get; set; }

    [SupplyParameterFromQuery(Name = "fromUtc")]
    public DateTime? FromUtcQuery { get; set; }

    [SupplyParameterFromQuery(Name = "toUtc")]
    public DateTime? ToUtcQuery { get; set; }

    private DateTimeOffset? FromUtc => FromUtcQuery.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(FromUtcQuery.Value, DateTimeKind.Utc)) : null;

    private DateTimeOffset? ToUtc => ToUtcQuery.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(ToUtcQuery.Value, DateTimeKind.Utc)) : null;

    private static readonly ShipmentStatus[] ActiveShipmentStatuses =
    [
        ShipmentStatus.Assigned,
        ShipmentStatus.PickingUp,
        ShipmentStatus.PickedUp,
        ShipmentStatus.InTransit,
        ShipmentStatus.Delivering
    ];

    private string ShopDisplayName { get; set; } = "Shop";

    private GetShopContextResponse? ShopContext { get; set; }

    private Guid SelectedShopId { get; set; }

    private ShopContextItemResponse? SelectedShop => ShopContext?.Shops
        .FirstOrDefault(shop => shop.ShopId == SelectedShopId);

    private bool CanManageShipments => SelectedShop?.Permissions.HasFlag(ShopPermission.ManageShipments) == true;

    private bool CanViewCod => SelectedShop?.Permissions.HasFlag(ShopPermission.ViewCod) == true;

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private ShopDashboardKpiResponse? DashboardKpi { get; set; }

    private IReadOnlyList<ShipmentListItemResponse> LatestShipments { get; set; } = [];

    private IReadOnlyList<DashboardCard> StatisticCards { get; set; } = [];

    private IReadOnlyList<StatusRow> StatusRows { get; set; } = [];

    private string FromDateInput { get; set; } = string.Empty;

    private string ToDateInput { get; set; } = string.Empty;

    private bool HasDateRange => !string.IsNullOrWhiteSpace(FromDateInput)
        || !string.IsNullOrWhiteSpace(ToDateInput);

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        DashboardKpi = null;
        LatestShipments = [];
        FromDateInput = FormatDateInput(FromUtc);
        ToDateInput = FormatDateInput(ToUtc);

        var userId = await GetCurrentUserIdAsync();
        if (userId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var contextResult = await GetShopContextService.GetAsync(userId.Value, ShopId);
        if (contextResult.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(contextResult.Error);
            IsLoading = false;
            BuildDashboardModel();
            return;
        }

        ShopContext = contextResult.Value;
        SelectedShopId = contextResult.Value.SelectedShopId;
        ShopDisplayName = SelectedShop?.Name ?? "Shop";

        var kpiResult = await GetShopDashboardKpiService.GetAsync(
            new ShopDashboardKpiQuery(
                OwnerUserId: userId.Value,
                ShopId: SelectedShopId,
                FromUtc: FromUtc,
                ToUtc: ToUtc));
        if (kpiResult.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(kpiResult.Error);
            IsLoading = false;
            BuildDashboardModel();
            return;
        }

        DashboardKpi = kpiResult.Value;

        var latestResult = await GetShipmentsForCurrentShopService.SearchAsync(
            new GetShipmentsForCurrentShopQuery(
                OwnerUserId: userId.Value,
                ShopId: SelectedShopId,
                FromUtc: FromUtc,
                ToUtc: ToUtc,
                PageNumber: 1,
                PageSize: 5));
        if (latestResult.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(latestResult.Error);
            IsLoading = false;
            BuildDashboardModel();
            return;
        }

        LatestShipments = latestResult.Value.Items;
        IsLoading = false;
        BuildDashboardModel();
    }

    private void OnShopChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var shopId))
        {
            NavigationManager.NavigateTo(BuildDashboardLink(shopId, FromUtc, ToUtc));
        }
    }

    private Task ApplyDateRangeAsync()
    {
        NavigationManager.NavigateTo(BuildDashboardLink(
            SelectedShopId,
            ParseDateInput(FromDateInput, endOfDay: false),
            ParseDateInput(ToDateInput, endOfDay: true)));

        return Task.CompletedTask;
    }

    private Task ClearDateRangeAsync()
    {
        FromDateInput = string.Empty;
        ToDateInput = string.Empty;
        NavigationManager.NavigateTo(BuildDashboardLink(SelectedShopId, null, null));

        return Task.CompletedTask;
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdValue = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        return Guid.TryParse(userIdValue, out var userId)
            ? userId
            : null;
    }

    private string BuildShopLink(string path)
    {
        return BuildShopLink(path, SelectedShopId);
    }

    private static string BuildShopLink(string path, Guid shopId)
    {
        return AppendQueryParameter(path, "shopId", shopId == Guid.Empty ? null : shopId.ToString("D"));
    }

    private void BuildDashboardModel()
    {
        var kpi = DashboardKpi;
        var totalShipments = kpi?.TotalShipments ?? 0;
        var activeShipments = CountByStatuses(ActiveShipmentStatuses);
        var deliveredShipments = kpi?.DeliveredShipments ?? 0;
        var failedShipments = kpi?.DeliveryFailedShipments ?? 0;
        var pendingCodAmount = kpi?.PendingCodAmount ?? 0m;
        var shippingFeeAmount = kpi?.TotalShippingFee ?? 0m;
        var currency = kpi?.Currency ?? "VND";

        var statisticCards = new List<DashboardCard>
        {
            new("Tổng đơn hàng", totalShipments.ToString("N0"), "Theo bộ lọc hiện tại", "package", "primary"),
            new("Đang vận chuyển", activeShipments.ToString("N0"), "Đơn chưa hoàn tất", "truck", "warning"),
            new("Giao thành công", deliveredShipments.ToString("N0"), $"Tỷ lệ {FormatPercentage(kpi?.DeliveredRate ?? 0m)}", "check", "success"),
            new("Giao thất bại", failedShipments.ToString("N0"), $"Tỷ lệ {FormatPercentage(kpi?.DeliveryFailedRate ?? 0m)}", "alert", "danger")
        };
        if (CanViewCod)
        {
            statisticCards.Add(new("COD cần thu", FormatMoney(pendingCodAmount, currency), "Theo đơn đang chờ thu", "wallet", "warning"));
        }
        statisticCards.Add(new("Tổng phí vận chuyển", FormatMoney(shippingFeeAmount, currency), "Tổng hợp theo kỳ", "wallet", "primary"));
        StatisticCards = statisticCards;

        StatusRows =
        [
            CreateStatusRow(ShipmentStatus.Draft, "Draft", "slate", totalShipments),
            CreateStatusRow(ShipmentStatus.PendingPickup, "Chờ lấy hàng", "blue", totalShipments),
            CreateStatusRow(ShipmentStatus.Assigned, "Đã phân công", "amber", totalShipments),
            CreateStatusRow(ShipmentStatus.PickingUp, "Đang lấy hàng", "amber", totalShipments),
            CreateStatusRow(ShipmentStatus.PickedUp, "Đã lấy hàng", "amber", totalShipments),
            CreateStatusRow(ShipmentStatus.InTransit, "Đang vận chuyển", "purple", totalShipments),
            CreateStatusRow(ShipmentStatus.Delivering, "Đang giao", "teal", totalShipments),
            CreateStatusRow(ShipmentStatus.Delivered, "Đã giao", "green", totalShipments),
            CreateStatusRow(ShipmentStatus.DeliveryFailed, "Giao thất bại", "red", totalShipments),
            CreateStatusRow(ShipmentStatus.Returned, "Đã hoàn", "slate", totalShipments),
            CreateStatusRow(ShipmentStatus.Cancelled, "Đã hủy", "slate", totalShipments)
        ];
    }

    private int CountByStatus(ShipmentStatus status)
    {
        return DashboardKpi?.CountByStatus.GetValueOrDefault(status) ?? 0;
    }

    private int CountByStatuses(IReadOnlyCollection<ShipmentStatus> statuses)
    {
        return statuses.Sum(CountByStatus);
    }

    private StatusRow CreateStatusRow(
        ShipmentStatus status,
        string label,
        string className,
        int totalShipments)
    {
        var count = CountByStatus(status);
        var percentage = totalShipments == 0
            ? 0
            : (decimal)count / totalShipments * 100;

        return new StatusRow(label, className, count, percentage);
    }

    private static string FormatDate(DateTimeOffset value)
    {
        return UiDisplay.FormatLocalDateTime(value);
    }

    private static string FormatMoney(decimal amount, string currency)
    {
        return $"{amount.ToString("N0")} {currency}";
    }

    private static string FormatPercentage(decimal value)
    {
        return $"{value:N2}%";
    }

    private static string FormatRouteType(RouteType routeType)
    {
        return routeType switch
        {
            RouteType.IntraProvince => "Nội tỉnh",
            RouteType.IntraRegion => "Nội vùng",
            RouteType.InterRegion => "Liên vùng",
            _ => routeType.ToString()
        };
    }

    private static string FormatStatus(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.PendingPickup => "Chờ lấy hàng",
            ShipmentStatus.Assigned => "Đã phân công",
            ShipmentStatus.PickingUp => "Đang lấy hàng",
            ShipmentStatus.PickedUp => "Đã lấy hàng",
            ShipmentStatus.InTransit => "Đang vận chuyển",
            ShipmentStatus.Delivering => "Đang giao",
            ShipmentStatus.Delivered => "Đã giao",
            ShipmentStatus.DeliveryFailed => "Giao thất bại",
            ShipmentStatus.Returned => "Đã hoàn",
            ShipmentStatus.Cancelled => "Đã hủy",
            ShipmentStatus.Draft => "Draft",
            _ => status.ToString()
        };
    }

    private static string GetStatusClass(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Delivered => "success",
            ShipmentStatus.Cancelled or ShipmentStatus.DeliveryFailed or ShipmentStatus.Returned => "danger",
            ShipmentStatus.InTransit or ShipmentStatus.Delivering or ShipmentStatus.PickedUp => "info",
            _ => "warning"
        };
    }

    private static DateTimeOffset? ParseDateInput(string value, bool endOfDay)
    {
        if (!DateOnly.TryParse(value, out var date))
        {
            return null;
        }

        var time = endOfDay ? TimeOnly.MaxValue : TimeOnly.MinValue;
        return new DateTimeOffset(date.ToDateTime(time), TimeSpan.Zero);
    }

    private static string FormatDateInput(DateTimeOffset? value)
    {
        return value?.UtcDateTime.ToString("yyyy-MM-dd") ?? string.Empty;
    }

    private static string BuildDashboardLink(Guid shopId, DateTimeOffset? fromUtc, DateTimeOffset? toUtc)
    {
        var url = BuildShopLink("/dashboard", shopId);
        url = AppendQueryParameter(url, "fromUtc", fromUtc?.ToString("O"));
        return AppendQueryParameter(url, "toUtc", toUtc?.ToString("O"));
    }

    private static string AppendQueryParameter(string url, string name, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return url;
        }

        var separator = url.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return $"{url}{separator}{Uri.EscapeDataString(name)}={Uri.EscapeDataString(value)}";
    }

    private sealed record DashboardCard(string Label, string Value, string Note, string Icon, string Tone);

    private sealed record StatusRow(string Label, string ClassName, int Count, decimal Percentage);

}
