@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Shop")]
@using System.Security.Claims
@using MiniLogistics.Application.Shops.GetShopContext
@using MiniLogistics.Application.Shops.Reports
@using MiniLogistics.Application.Shipments.GetShipmentsForCurrentShop
@using MiniLogistics.Domain.Shipments
@using MiniLogistics.Domain.Shops
@inject IGetShopContextService GetShopContextService
@inject IGetShopDashboardKpiService GetShopDashboardKpiService
@inject IGetShipmentsForCurrentShopService GetShipmentsForCurrentShopService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Tổng quan cửa hàng - MiniLogistics</PageTitle>

<div class="dashboard-page" aria-busy="@IsLoading">
    <UiPageHeader Title="@ShopDisplayName" Description="Tổng quan đơn hàng và tiền thu hộ." Icon="layout-dashboard">
        <Actions>
            <button type="button" class="ui-button ui-button--secondary" disabled="@IsLoading" @onclick="OnParametersSetAsync">
                <AppIcon Name="refresh" Size="18" /> Làm mới
            </button>
            @if (CanManageShipments && SelectedShop?.IsActive == true)
            {
                <a class="ui-button ui-button--primary" href="@(BuildShopLink("/shipments/create"))">
                    <AppIcon Name="plus" Size="18" /> Tạo đơn hàng
                </a>
            }
        </Actions>
    </UiPageHeader>

    @if (ShopContext is not null)
    {
        <section class="dashboard-toolbar" aria-label="Bộ lọc tổng quan">
            @if (ShopContext.Shops.Count > 1)
            {
                <label class="field shop-picker" for="dashboard-shop-context">Cửa hàng
                    <select id="dashboard-shop-context" value="@SelectedShopId" @onchange="OnShopChanged" disabled="@IsLoading">
                        @foreach (var shop in ShopContext.Shops)
                        {
                            <option value="@shop.ShopId">@shop.Name@(shop.IsActive ? "" : " (Tạm ngưng)")</option>
                        }
                    </select>
                </label>
            }
            <div class="date-presets" aria-label="Chọn nhanh khoảng ngày">
                <button type="button" aria-pressed="@(!HasDateRange)" disabled="@IsLoading" @onclick="ClearDateRangeAsync">Tất cả</button>
                <button type="button" aria-pressed="@IsPresetApplied(7)" disabled="@IsLoading" @onclick="() => ApplyPresetAsync(7)">7 ngày</button>
                <button type="button" aria-pressed="@IsPresetApplied(30)" disabled="@IsLoading" @onclick="() => ApplyPresetAsync(30)">30 ngày</button>
            </div>
            <div class="date-fields">
                <label class="field" for="dashboard-from">Từ ngày (UTC)
                    <input id="dashboard-from" type="date" value="@FromDateInput" @onchange="args => FromDateInput = args.Value?.ToString() ?? string.Empty" disabled="@IsLoading" />
                </label>
                <label class="field" for="dashboard-to">Đến ngày (UTC)
                    <input id="dashboard-to" type="date" value="@ToDateInput" @onchange="args => ToDateInput = args.Value?.ToString() ?? string.Empty" disabled="@IsLoading" />
                </label>
                <button type="button" class="ui-button ui-button--secondary" @onclick="ApplyDateRangeAsync" disabled="@(IsLoading || DateRangeError is not null)">Áp dụng</button>
            </div>
        </section>
        @if (DateRangeError is not null)
        {
            <p class="filter-error" role="alert">@DateRangeError</p>
        }
        @if (SelectedShop?.IsActive == false)
        {
            <UiAlert Message="Cửa hàng đang tạm ngưng. Bạn vẫn có thể xem dữ liệu đã lưu." Tone="warning" />
        }
    }

    <UiAlert Message="@ErrorMessage" Tone="danger" />
    @if (IsLoading)
    {
        <UiLoadingState Title="Đang tải tổng quan" Description="Đang cập nhật đơn hàng và tiền thu hộ." />
    }
    else if (DashboardKpi is not null)
    {
        <p class="dataset-period">@AppliedRangeLabel</p>
        <section class="stats-grid" aria-label="Tóm tắt đơn hàng">
            @foreach (var card in StatisticCards)
            {
                <UiMetricCard Label="@card.Label" Value="@card.Value" Note="@card.Note" Icon="@card.Icon" Tone="@card.Tone" Href="@card.Href" />
            }
        </section>

        <section class="overview-grid">
            <article class="dashboard-card">
                <div class="card-heading"><h2>Tiến độ giao nhận</h2></div>
                <UiShipmentDistribution Counts="@DashboardKpi.CountByStatus" />
            </article>
            <article class="dashboard-card">
                <div class="card-heading">
                    <h2>@(CanViewCod ? "Phí và tiền thu hộ" : "Phí vận chuyển")</h2>
                    @if (CanViewCod) { <a href="@(BuildShopLink("/shop/cod-report"))">Báo cáo COD</a> }
                </div>
                <dl class="money-list">
                    @if (CanViewCod)
                    {
                        <div><dt>COD chờ thu</dt><dd>@FormatMoney(DashboardKpi.PendingCodAmount, DashboardKpi.Currency)</dd></div>
                        <div><dt>COD đã thu</dt><dd>@FormatMoney(DashboardKpi.CollectedCodAmount, DashboardKpi.Currency)</dd></div>
                    }
                    <div><dt>Phí vận chuyển</dt><dd>@FormatMoney(DashboardKpi.TotalShippingFee, DashboardKpi.Currency)</dd></div>
                </dl>
                <p class="money-note">Theo ngày tạo đơn trong khoảng đã chọn.</p>
            </article>
        </section>

        <section class="dashboard-card">
            <div class="card-heading">
                <h2>Đơn hàng mới nhất</h2>
                <a href="@ShipmentListLink">Xem tất cả <AppIcon Name="arrow-right" Size="16" /></a>
            </div>
            @if (!string.IsNullOrWhiteSpace(LatestErrorMessage))
            {
                <UiAlert Message="@LatestErrorMessage" Tone="danger" />
            }
            else if (LatestShipments.Count == 0)
            {
                <div class="empty-state">
                    <AppIcon Name="package" Size="32" />
                    <strong>@(HasDateRange ? "Không có đơn trong khoảng đã chọn" : "Chưa có đơn hàng")</strong>
                    <p>@(HasDateRange ? "Thử chọn khoảng ngày khác để xem đơn hàng." : "Tạo đơn đầu tiên để bắt đầu theo dõi giao nhận.")</p>
                    @if (!HasDateRange && CanManageShipments && SelectedShop?.IsActive == true)
                    {
                        <a class="ui-button ui-button--primary" href="@(BuildShopLink("/shipments/create"))">Tạo đơn đầu tiên</a>
                    }
                </div>
            }
            else
            {
                <div class="table-wrap" role="region" aria-label="Đơn hàng mới nhất" tabindex="0">
                    <table>
                        <caption class="visually-hidden">Năm đơn hàng mới nhất trong khoảng thời gian đã chọn</caption>
                        <thead><tr>
                            <th scope="col">Mã vận đơn</th><th scope="col">Người nhận</th><th scope="col">Trạng thái</th>
                            @if (CanViewCod) { <th scope="col" class="numeric">COD</th> }
                            <th scope="col" class="numeric">Phí vận chuyển</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var shipment in LatestShipments)
                            {
                                <tr>
                                    <td><a class="tracking-link" href="@(BuildShopLink($"/shipments/{shipment.ShipmentId}"))">@shipment.TrackingCode</a><small>@FormatDate(shipment.CreatedAtUtc)</small></td>
                                    <td>@shipment.ReceiverName<small>@FormatRouteType(shipment.RouteType)</small></td>
                                    <td><span class="status-pill @GetStatusClass(shipment.Status)">@FormatStatus(shipment.Status)</span></td>
                                    @if (CanViewCod) { <td class="numeric">@FormatMoney(shipment.CodAmount, shipment.Currency)</td> }
                                    <td class="numeric">@FormatMoney(shipment.ShippingFeeAmount, shipment.Currency)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "shopId")]
    public Guid? ShopId { get; set; }

    [SupplyParameterFromQuery(Name = "fromUtc")]
    public DateTime? FromUtcQuery { get; set; }

    [SupplyParameterFromQuery(Name = "toUtc")]
    public DateTime? ToUtcQuery { get; set; }

    private DateTimeOffset? FromUtc => DashboardPresentation.NormalizeUtcQuery(FromUtcQuery);

    private DateTimeOffset? ToUtc => DashboardPresentation.NormalizeUtcQuery(ToUtcQuery);

    private string ShopDisplayName { get; set; } = "Shop";

    private GetShopContextResponse? ShopContext { get; set; }

    private Guid SelectedShopId { get; set; }

    private ShopContextItemResponse? SelectedShop => ShopContext?.Shops
        .FirstOrDefault(shop => shop.ShopId == SelectedShopId);

    private bool CanManageShipments => SelectedShop?.Permissions.HasFlag(ShopPermission.ManageShipments) == true;

    private bool CanViewCod => SelectedShop?.Permissions.HasFlag(ShopPermission.ViewCod) == true;

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private ShopDashboardKpiResponse? DashboardKpi { get; set; }

    private IReadOnlyList<ShipmentListItemResponse> LatestShipments { get; set; } = [];

    private IReadOnlyList<DashboardCard> StatisticCards { get; set; } = [];

    private string? LatestErrorMessage { get; set; }

    private string? DateRangeError => DashboardPresentation.DateRangeError(FromDateInput, ToDateInput);

    private string AppliedRangeLabel => FromUtc is null && ToUtc is null
        ? "Toàn bộ đơn hàng"
        : $"Đơn tạo từ {FromUtc?.ToString("dd/MM/yyyy") ?? "đầu kỳ"} đến {ToUtc?.ToString("dd/MM/yyyy") ?? "hiện tại"} (UTC)";

    private string ShipmentListLink => DashboardPresentation.ShipmentListUrl(SelectedShopId, FromUtc, ToUtc);

    private string FromDateInput { get; set; } = string.Empty;

    private string ToDateInput { get; set; } = string.Empty;

    private bool HasDateRange => !string.IsNullOrWhiteSpace(FromDateInput)
        || !string.IsNullOrWhiteSpace(ToDateInput);

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        LatestErrorMessage = null;
        ShopContext = null;
        StatisticCards = [];
        DashboardKpi = null;
        LatestShipments = [];
        FromDateInput = FormatDateInput(FromUtc);
        ToDateInput = FormatDateInput(ToUtc);

        var userId = await GetCurrentUserIdAsync();
        if (userId is null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var contextResult = await GetShopContextService.GetAsync(userId.Value, ShopId);
        if (contextResult.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(contextResult.Error);
            IsLoading = false;
            BuildDashboardModel();
            return;
        }

        ShopContext = contextResult.Value;
        SelectedShopId = contextResult.Value.SelectedShopId;
        ShopDisplayName = SelectedShop?.Name ?? "Shop";

        var kpiResult = await GetShopDashboardKpiService.GetAsync(
            new ShopDashboardKpiQuery(
                OwnerUserId: userId.Value,
                ShopId: SelectedShopId,
                FromUtc: FromUtc,
                ToUtc: ToUtc));
        if (kpiResult.IsFailure)
        {
            ErrorMessage = UiDisplay.ToErrorMessage(kpiResult.Error);
            IsLoading = false;
            BuildDashboardModel();
            return;
        }

        DashboardKpi = kpiResult.Value;

        var latestResult = await GetShipmentsForCurrentShopService.SearchAsync(
            new GetShipmentsForCurrentShopQuery(
                OwnerUserId: userId.Value,
                ShopId: SelectedShopId,
                FromUtc: FromUtc,
                ToUtc: ToUtc,
                PageNumber: 1,
                PageSize: 5));
        if (latestResult.IsFailure)
        {
            LatestErrorMessage = UiDisplay.ToErrorMessage(latestResult.Error);
            IsLoading = false;
            BuildDashboardModel();
            return;
        }

        LatestShipments = latestResult.Value.Items;
        IsLoading = false;
        BuildDashboardModel();
    }

    private void OnShopChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var shopId))
        {
            NavigationManager.NavigateTo(BuildDashboardLink(shopId, FromUtc, ToUtc));
        }
    }

    private Task ApplyDateRangeAsync()
    {
        if (DateRangeError is not null) return Task.CompletedTask;
        NavigationManager.NavigateTo(BuildDashboardLink(
            SelectedShopId,
            ParseDateInput(FromDateInput, endOfDay: false),
            ParseDateInput(ToDateInput, endOfDay: true)));

        return Task.CompletedTask;
    }

    private Task ApplyPresetAsync(int days)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        FromDateInput = today.AddDays(1 - days).ToString("yyyy-MM-dd");
        ToDateInput = today.ToString("yyyy-MM-dd");
        return ApplyDateRangeAsync();
    }

    private bool IsPresetApplied(int days)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        return FromUtc.HasValue && ToUtc.HasValue
            && DateOnly.FromDateTime(FromUtc.Value.UtcDateTime) == today.AddDays(1 - days)
            && DateOnly.FromDateTime(ToUtc.Value.UtcDateTime) == today;
    }

    private Task ClearDateRangeAsync()
    {
        FromDateInput = string.Empty;
        ToDateInput = string.Empty;
        NavigationManager.NavigateTo(BuildDashboardLink(SelectedShopId, null, null));

        return Task.CompletedTask;
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdValue = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        return Guid.TryParse(userIdValue, out var userId)
            ? userId
            : null;
    }

    private string BuildShopLink(string path)
    {
        return BuildShopLink(path, SelectedShopId);
    }

    private static string BuildShopLink(string path, Guid shopId)
    {
        return AppendQueryParameter(path, "shopId", shopId == Guid.Empty ? null : shopId.ToString("D"));
    }

    private void BuildDashboardModel()
    {
        if (DashboardKpi is not { } kpi) { StatisticCards = []; return; }
        StatisticCards =
        [
            new("Tổng đơn hàng", kpi.TotalShipments.ToString("N0"), "Trong khoảng đã chọn", "package", "primary", ShipmentListLink),
            new("Chờ lấy hàng", kpi.CountByStatus.GetValueOrDefault(ShipmentStatus.PendingPickup).ToString("N0"), "Đơn đang chờ xử lý", "clock", "warning", StatusLink(ShipmentStatus.PendingPickup)),
            new("Giao thành công", kpi.DeliveredShipments.ToString("N0"), $"{kpi.DeliveredRate:N1}% đơn không nháp", "circle-check", "success", StatusLink(ShipmentStatus.Delivered)),
            new("Giao thất bại", kpi.DeliveryFailedShipments.ToString("N0"), "Cần theo dõi giao lại", "triangle-alert", "danger", StatusLink(ShipmentStatus.DeliveryFailed))
        ];
    }

    private string StatusLink(ShipmentStatus status) =>
        DashboardPresentation.ShipmentListUrl(SelectedShopId, FromUtc, ToUtc, status);

    private static string FormatDate(DateTimeOffset value)
    {
        return UiDisplay.FormatLocalDateTime(value);
    }

    private static string FormatMoney(decimal amount, string currency)
    {
        return $"{amount.ToString("N0")} {currency}";
    }

    private static string FormatRouteType(RouteType routeType)
    {
        return routeType switch
        {
            RouteType.IntraProvince => "Nội tỉnh",
            RouteType.IntraRegion => "Nội vùng",
            RouteType.InterRegion => "Liên vùng",
            _ => routeType.ToString()
        };
    }

    private static string FormatStatus(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.PendingPickup => "Chờ lấy hàng",
            ShipmentStatus.Assigned => "Đã phân công",
            ShipmentStatus.PickingUp => "Đang lấy hàng",
            ShipmentStatus.PickedUp => "Đã lấy hàng",
            ShipmentStatus.InTransit => "Đang vận chuyển",
            ShipmentStatus.Delivering => "Đang giao",
            ShipmentStatus.Delivered => "Đã giao",
            ShipmentStatus.DeliveryFailed => "Giao thất bại",
            ShipmentStatus.Returned => "Đã hoàn",
            ShipmentStatus.Cancelled => "Đã hủy",
            ShipmentStatus.Draft => "Bản nháp",
            _ => status.ToString()
        };
    }

    private static string GetStatusClass(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Delivered => "success",
            ShipmentStatus.Cancelled or ShipmentStatus.DeliveryFailed or ShipmentStatus.Returned => "danger",
            ShipmentStatus.InTransit or ShipmentStatus.Delivering or ShipmentStatus.PickedUp => "info",
            _ => "warning"
        };
    }

    private static DateTimeOffset? ParseDateInput(string value, bool endOfDay)
    {
        if (!DateOnly.TryParse(value, out var date))
        {
            return null;
        }

        var time = endOfDay ? TimeOnly.MaxValue : TimeOnly.MinValue;
        return new DateTimeOffset(date.ToDateTime(time), TimeSpan.Zero);
    }

    private static string FormatDateInput(DateTimeOffset? value)
    {
        return value?.UtcDateTime.ToString("yyyy-MM-dd") ?? string.Empty;
    }

    private static string BuildDashboardLink(Guid shopId, DateTimeOffset? fromUtc, DateTimeOffset? toUtc)
    {
        var url = BuildShopLink("/dashboard", shopId);
        url = AppendQueryParameter(url, "fromUtc", fromUtc?.ToString("O"));
        return AppendQueryParameter(url, "toUtc", toUtc?.ToString("O"));
    }

    private static string AppendQueryParameter(string url, string name, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return url;
        }

        var separator = url.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return $"{url}{separator}{Uri.EscapeDataString(name)}={Uri.EscapeDataString(value)}";
    }

    private sealed record DashboardCard(string Label, string Value, string Note, string Icon, string Tone, string Href);

}
