@using MiniLogistics.Domain.Shipments

@if (Groups.Count == 0)
{
    <p class="distribution-empty">Chưa có đơn hàng trong khoảng thời gian này.</p>
}
else
{
    <div class="distribution" aria-label="Phân bố trạng thái đơn hàng">
        <div class="distribution-track" aria-hidden="true">
            @foreach (var group in Groups)
            {
                <span class="distribution-segment tone-@group.Tone" style="@($"flex-grow: {group.Count}")"></span>
            }
        </div>
        <ul class="distribution-list">
            @foreach (var group in Groups)
            {
                <li>
                    <span class="distribution-dot tone-@group.Tone" aria-hidden="true"></span>
                    <span>@group.Label</span>
                    <strong>@group.Count.ToString("N0")</strong>
                    <span class="distribution-percentage">@group.Percentage.ToString("N1")%</span>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyDictionary<ShipmentStatus, int> Counts { get; set; } = new Dictionary<ShipmentStatus, int>();
    private IReadOnlyList<DashboardStatusGroup> Groups { get; set; } = [];
    protected override void OnParametersSet() => Groups = DashboardPresentation.GroupStatuses(Counts);
}
