<article class="ui-metric ui-metric--@Tone">
    <span class="ui-metric__icon"><AppIcon Name="@Icon" Size="21" /></span>
    <span class="ui-metric__label">@Label</span>
    <strong>@Value</strong>
    @if (!string.IsNullOrWhiteSpace(Note)) { <small>@Note</small> }
</article>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Note { get; set; }
    [Parameter] public string Icon { get; set; } = "activity";
    [Parameter] public string Tone { get; set; } = "primary";
}
