<svg class="app-icon @Class"
     style="--app-icon-size: @(Size)px"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.8"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">
    @switch (Name)
    {
        case "activity":
            <path d="M3 12h4l2.4-7 4.2 14 2.4-7h5" />
            break;
        case "alert":
            <path d="M10.3 3.7 2.4 17.4A2 2 0 0 0 4.1 20h15.8a2 2 0 0 0 1.7-2.6L13.7 3.7a2 2 0 0 0-3.4 0Z" />
            <path d="M12 9v4" /><path d="M12 17h.01" />
            break;
        case "check":
            <circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        case "key":
            <circle cx="8" cy="15" r="4" /><path d="m11 12 8-8M15 8l2 2M17 6l2 2" />
            break;
        case "package":
            <path d="m4 7 8-4 8 4-8 4-8-4Z" /><path d="M4 7v10l8 4 8-4V7M12 11v10" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "refresh":
            <path d="M20 11a8 8 0 1 0-2.3 5.7" /><path d="M20 5v6h-6" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
            break;
        case "store":
            <path d="M4 10v10h16V10M3 10l2-6h14l2 6" /><path d="M8 20v-6h8v6M3 10a3 3 0 0 0 5 2 3 3 0 0 0 4 0 3 3 0 0 0 4 0 3 3 0 0 0 5-2" />
            break;
        case "truck":
            <path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z" /><circle cx="7" cy="18" r="2" /><circle cx="18" cy="18" r="2" />
            break;
        case "users":
            <path d="M16 20v-1.5a4.5 4.5 0 0 0-4.5-4.5h-3A4.5 4.5 0 0 0 4 18.5V20" /><circle cx="10" cy="7" r="4" /><path d="M17 11a4 4 0 0 1 3 3.9V20" />
            break;
        case "wallet":
            <path d="M4 6h14a2 2 0 0 1 2 2v10H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h12" /><path d="M16 11h4v4h-4a2 2 0 0 1 0-4Z" />
            break;
        case "webhook":
            <path d="M18 16a3 3 0 1 1-2.8 4H9M6 8a3 3 0 1 1 4.8-2.4l3.7 6.4M6 8l-3.5 6A3 3 0 1 0 5 18h7" />
            break;
        default:
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "info";

    [Parameter]
    public int Size { get; set; } = 20;

    [Parameter]
    public string? Class { get; set; }
}
