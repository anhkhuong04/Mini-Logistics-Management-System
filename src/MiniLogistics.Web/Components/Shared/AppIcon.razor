<Blazicon Svg="GetIcon(Name)"
          class="@CssClass"
          style="@CssStyle"
          aria-hidden="true"
          focusable="false" />

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "info";

    [Parameter]
    public int Size { get; set; } = 20;

    [Parameter]
    public string? Class { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "app-icon"
        : $"app-icon {Class}";

    private string CssStyle => $"--app-icon-size: {Size}px";

    private static SvgIcon GetIcon(string name) => name.ToLowerInvariant() switch
    {
        "activity" => Lucide.Activity,
        "arrow-left" => Lucide.ArrowLeft,
        "arrow-right" => Lucide.ArrowRight,
        "alert" => Lucide.TriangleAlert,
        "box" => Lucide.Box,
        "bell" => Lucide.Bell,
        "check" => Lucide.Check,
        "chevron-down" => Lucide.ChevronDown,
        "chevron-right" => Lucide.ChevronRight,
        "clock" => Lucide.Clock,
        "circle-check" => Lucide.CircleCheck,
        "circle-alert" => Lucide.CircleAlert,
        "download" => Lucide.Download,
        "file-text" => Lucide.FileText,
        "home" => Lucide.House,
        "key" => Lucide.KeyRound,
        "layout-dashboard" => Lucide.LayoutDashboard,
        "lightbulb" => Lucide.Lightbulb,
        "link" => Lucide.Link,
        "list-checks" => Lucide.ListChecks,
        "log-in" => Lucide.LogIn,
        "log-out" => Lucide.LogOut,
        "image" => Lucide.Image,
        "globe" => Lucide.Globe,
        "menu" => Lucide.Menu,
        "package" => Lucide.Package,
        "pause" => Lucide.Pause,
        "pencil" => Lucide.Pencil,
        "play" => Lucide.Play,
        "plus" => Lucide.Plus,
        "refresh" => Lucide.RefreshCw,
        "receipt" => Lucide.Receipt,
        "route" => Lucide.Route,
        "save" => Lucide.Save,
        "search" => Lucide.Search,
        "send" => Lucide.Send,
        "settings" => Lucide.Settings2,
        "store" => Lucide.Store,
        "truck" => Lucide.Truck,
        "triangle-alert" => Lucide.TriangleAlert,
        "trash" => Lucide.Trash2,
        "users" => Lucide.Users,
        "upload" => Lucide.Upload,
        "wallet" => Lucide.WalletCards,
        "warehouse" => Lucide.Warehouse,
        "webhook" => Lucide.Webhook,
        "x" => Lucide.X,
        _ => Lucide.Info
    };
}
