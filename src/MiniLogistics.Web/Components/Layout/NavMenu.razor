@inject IStringLocalizer<SharedResource> L

<div class="nav-shell">
    <a class="brand" href="/" aria-label="LAK Logistics">
        <img src="/images/landing/lak-logo.svg" alt="LAK Logistics" class="brand-logo" />
    </a>

    <div class="nav-scrollable" @onclick="NotifyNavigationAsync">
        <AuthorizeView Context="authContext">
            <Authorized>
                <nav class="nav-group" aria-label="Authenticated navigation">
                    <AuthorizeView Roles="Shop" Context="shopContext">
                        <Authorized>
                            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                                <svg viewBox="0 0 24 24"><path d="M4 11.2 12 4l8 7.2V20h-6v-5h-4v5H4v-8.8Z" /></svg>
                                <span>@L["Nav_Overview"]</span>
                            </NavLink>

                            <span class="nav-section">@L["Nav_Shipments"]</span>

                            <NavLink class="nav-link" href="shipments/create">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z" /></svg>
                                <span>@L["Nav_CreateShipment"]</span>
                            </NavLink>

                            <NavLink class="nav-link muted-link" href="shipments">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Zm2 1.2v6.6l5 2.8v-6.6L6 8.7Zm7 9.4 5-2.8V8.7l-5 2.8v6.6Zm-6-11L12 10l5-2.9-5-2.8-5 2.8Z" /></svg>
                                <span>@L["Nav_ShipmentList"]</span>
                            </NavLink>

                            <NavLink class="nav-link muted-link" href="shop/cod-report">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm1 14h-2v-1.1a4.2 4.2 0 0 1-2.5-1.1l1.1-1.6c.8.6 1.6 1 2.6 1 .8 0 1.3-.3 1.3-.8 0-.6-.4-.8-1.9-1.2-1.9-.5-3-1.2-3-2.8 0-1.4 1-2.5 2.4-2.8V5h2v1.4c.8.1 1.5.4 2.2.9L14 8.9c-.7-.5-1.3-.7-2-.7s-1.1.3-1.1.8c0 .6.4.8 2 1.2 1.9.5 2.8 1.3 2.8 2.8 0 1.5-1 2.5-2.7 2.8V17Z" /></svg>
                                <span>@L["Nav_CodReport"]</span>
                            </NavLink>

                            <NavLink class="nav-link muted-link" href="shop/notifications">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.4-2h-4.8a2.5 2.5 0 0 0 2.4 2Zm7-6-2-2.4V9a5 5 0 0 0-4-4.9V3h-2v1.1A5 5 0 0 0 7 9v4.6L5 16v2h14v-2ZM8 16l1-1.2V9a3 3 0 0 1 6 0v5.8l1 1.2H8Z" /></svg>
                                <span>@L["Nav_Notifications"]</span>
                            </NavLink>

                            <NavLink class="nav-link muted-link" href="shop/audit">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v18H5V3Zm2 2v14h10V5H7Zm2 3h6v2H9V8Zm0 4h6v2H9v-2Zm0 4h4v2H9v-2Z" /></svg>
                                <span>@L["Nav_ActivityHistory"]</span>
                            </NavLink>

                            <NavLink class="nav-link muted-link" href="shop/staff">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4 0-7 2-7 5v1h11v-1c0-1.5.5-2.9 1.4-4A10.8 10.8 0 0 0 9 14Zm9-2v3h-3v2h3v3h2v-3h3v-2h-3v-3h-2Z" /></svg>
                                <span>@L["Nav_ShopStaff"]</span>
                            </NavLink>

                            <NavLink class="nav-link muted-link" href="partner/integrations">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h4v2H7a3 3 0 0 0 0 6h4v2H7A5 5 0 0 1 7 7Zm3 4h4v2h-4v-2Zm3-4h4a5 5 0 0 1 0 10h-4v-2h4a3 3 0 0 0 0-6h-4V7Z" /></svg>
                                <span>@L["Nav_ApiIntegration"]</span>
                            </NavLink>

                            <NavLink class="nav-link muted-link" href="profile">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.2 0-7 2.1-7 5v1h14v-1c0-2.9-2.8-5-7-5Z" /></svg>
                                <span>@L["Nav_ShopProfile"]</span>
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="Admin" Context="adminContext">
                        <Authorized>
                            <span class="nav-section">@L["Nav_Administration"]</span>

                            <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4V4Zm9 0h7v4h-7V4ZM4 13h7v7H4v-7Zm9-3h7v10h-7V10Z" /></svg>
                                <span>@L["Nav_Dashboard"]</span>
                            </NavLink>

                            <NavLink class="nav-link" href="admin/users">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.1 0-7 2.2-7 5.2V20h14v-.8c0-3-2.9-5.2-7-5.2Zm7-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 2c-.8 0-1.5.1-2.1.4 1.7 1.1 2.8 2.8 3 4.8H23v-.5c0-2.7-1.7-4.7-4-4.7Z" /></svg>
                                <span>@L["Nav_Users"]</span>
                            </NavLink>

                            <NavLink class="nav-link" href="admin/shops">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10h16v10H4V10Zm2 2v6h12v-6H6Zm1-8h10l3 4H4l3-4Zm1 1.5L7 7h10l-1-1.5H8Z" /></svg>
                                <span>@L["Nav_Shops"]</span>
                            </NavLink>

                            <NavLink class="nav-link" href="admin/hubs">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 6v12l8 4 8-4V6l-8-4Zm0 2.2 5.2 2.6L12 9.4 6.8 6.8 12 4.2ZM6 8.4l5 2.5v8.2l-5-2.5V8.4Zm7 10.7v-8.2l5-2.5v8.2l-5 2.5Z" /></svg>
                                <span>@L["Nav_Hubs"]</span>
                            </NavLink>

                            <NavLink class="nav-link" href="admin/banners">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4V4zm2 2v12h12V6H6zm2 2h8v2H8V8zm0 4h5v2H8v-2z"/></svg>
                                <span>@L["Nav_Banners"]</span>
                            </NavLink>

                            <NavLink class="nav-link" href="admin/system-config">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v4H4V5Zm2 2h12v-.2H6V7Zm-2 4h7v8H4v-8Zm2 2v4h3v-4H6Zm7-2h7v8h-7v-8Zm2 2v4h3v-4h-3Z" /></svg>
                                <span>@L["Nav_SystemConfig"]</span>
                            </NavLink>

                            <NavLink class="nav-link" href="admin/cod">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm1 14h-2v-1.1a4.2 4.2 0 0 1-2.5-1.1l1.1-1.6c.8.6 1.6 1 2.6 1 .8 0 1.3-.3 1.3-.8 0-.6-.4-.8-1.9-1.2-1.9-.5-3-1.2-3-2.8 0-1.4 1-2.5 2.4-2.8V5h2v1.4c.8.1 1.5.4 2.2.9L14 8.9c-.7-.5-1.3-.7-2-.7s-1.1.3-1.1.8c0 .6.4.8 2 1.2 1.9.5 2.8 1.3 2.8 2.8 0 1.5-1 2.5-2.7 2.8V17Z" /></svg>
                                <span>@L["Nav_Cod"]</span>
                            </NavLink>

                            <NavLink class="nav-link" href="admin/audit-logs">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v18H5V3Zm2 2v14h10V5H7Zm2 3h6v2H9V8Zm0 4h6v2H9v-2Zm0 4h4v2H9v-2Z" /></svg>
                                <span>@L["Nav_AuditLog"]</span>
                            </NavLink>

                            <NavLink class="nav-link" href="partner/integrations">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h4v2H7a3 3 0 0 0 0 6h4v2H7A5 5 0 0 1 7 7Zm3 4h4v2h-4v-2Zm3-4h4a5 5 0 0 1 0 10h-4v-2h4a3 3 0 0 0 0-6h-4V7Z" /></svg>
                                <span>@L["Nav_ApiIntegration"]</span>
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="IntegrationAdmin" Context="integrationAdminContext">
                        <Authorized>
                            <span class="nav-section">@L["Nav_Integration"]</span>

                            <NavLink class="nav-link" href="partner/integrations">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h4v2H7a3 3 0 0 0 0 6h4v2H7A5 5 0 0 1 7 7Zm3 4h4v2h-4v-2Zm3-4h4a5 5 0 0 1 0 10h-4v-2h4a3 3 0 0 0 0-6h-4V7Z" /></svg>
                                <span>@L["Nav_ApiIntegration"]</span>
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="Admin,Operator" Context="operationsContext">
                        <Authorized>
                            <span class="nav-section">@L["Nav_Operations"]</span>

                            <NavLink class="nav-link" href="operations/assignments">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v4H5V4Zm0 6h9v4H5v-4Zm0 6h14v4H5v-4Zm11-6h3v4h-3v-4Z" /></svg>
                                <span>@L["Nav_Operations"]</span>
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="Shipper" Context="shipperContext">
                        <Authorized>
                            <span class="nav-section">@L["Shipper"]</span>

                            <NavLink class="nav-link" href="shipper/shipments">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v9h1.4l2-3H21v6h-2a3 3 0 0 1-6 0H9a3 3 0 0 1-6 0H2V8a2 2 0 0 1 1-2Zm2 2v7.8A3 3 0 0 1 8.8 17H13V8H5Zm10 2v5h.6l2-3H19v-2h-4Z" /></svg>
                                <span>@L["Nav_AssignedShipments"]</span>
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>

                    <span class="nav-section">@L["Nav_Lookup"]</span>

                    <NavLink class="nav-link muted-link" href="tracking">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 0 1 5.1 10.5l4 4-1.4 1.4-4-4A6.5 6.5 0 1 1 10.5 4Zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z" /></svg>
                        <span>@L["Nav_TrackShipment"]</span>
                    </NavLink>

                    <button type="button" class="nav-link logout-button" @onclick="OpenLogoutConfirmation">
                            <svg viewBox="0 0 24 24"><path d="M5 3h8v2H7v14h6v2H5V3Zm11 4 5 5-5 5v-4h-6v-2h6V7Z" /></svg>
                            <span>@L["SignOut"]</span>
                    </button>
                </nav>
            </Authorized>
            <NotAuthorized>
                <nav class="nav-group" aria-label="Guest navigation">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.2 12 4l8 7.2V20h-6v-5h-4v5H4v-8.8Z" /></svg>
                        <span>@L["Nav_Home"]</span>
                    </NavLink>
                    <NavLink class="nav-link" href="tracking">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 0 1 5.1 10.5l4 4-1.4 1.4-4-4A6.5 6.5 0 1 1 10.5 4Zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z" /></svg>
                        <span>@L["Nav_TrackShipment"]</span>
                    </NavLink>
                    <NavLink class="nav-link" href="login">
                        <span>@L["SignIn"]</span>
                    </NavLink>
                    <NavLink class="nav-link" href="register-shop">
                        <span>@L["Nav_RegisterShop"]</span>
                    </NavLink>
                </nav>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<ConfirmActionDialog IsOpen="@IsLogoutConfirmationOpen"
                     Title="@L["Logout_Title"]"
                     Message="@L["Logout_Message"]"
                     OnCancel="CloseLogoutConfirmation">
    <Footer>
        <button type="button" class="ui-button ui-button--secondary" @onclick="CloseLogoutConfirmation">@L["Stay"]</button>
        <form method="post" action="/auth/logout">
            <AntiforgeryToken />
            <button type="submit" class="ui-button ui-button--danger">@L["SignOut"]</button>
        </form>
    </Footer>
</ConfirmActionDialog>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    private bool IsLogoutConfirmationOpen { get; set; }

    private Task NotifyNavigationAsync() => OnNavigate.InvokeAsync();

    private void OpenLogoutConfirmation()
    {
        IsLogoutConfirmationOpen = true;
    }

    private void CloseLogoutConfirmation()
    {
        IsLogoutConfirmationOpen = false;
    }
}
